* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.cfg  text eol=lf
*.conf text eol=lf
*.h    text eol=lf
*.c    text eol=lf
*.patch text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
# Generated state files have byte-checked output, independent of core.autocrlf.
driver/state/defaults.generated.inf text eol=lf
driver/shim/generated/dc_scaler_geometry.inc text eol=lf
driver/shim/generated/dc_scaler_buffer.inc text eol=lf
driver/kmd/bc250kmd.inf text eol=crlf
driver/state/amdgpu-state.bin binary
# Shell scripts without an extension that run on the diagnostic USB
tools/diagusb/overlay/** text eol=lf
# A gate reads this list and a tool rewrites it: one line ending, on every machine
tools/quality/guardlog_width_baseline.txt text eol=lf
tools/quality/doclint_baseline.txt text eol=lf
tools/quality/claim_shares_baseline.txt text eol=lf
# The vendored STE linter and its licence are hash pinned in tools/quality/third_party/PROVENANCE.md
tools/quality/third_party/LICENSE-asd-ste100-skill.txt text eol=lf
# Evidence is stored byte for byte, never normalized
evidence/** -text

# The CTS case lists are hash pinned: batches/manifest.json holds the SHA256 of each batch file, and the
# runner refuses a batch whose file does not match. Line-ending normalization would break every hash.
tools/win/cts/batches/** -text
tools/win/cts/lists/** -text

# The two M16 WSI harness sources are hash pinned: the E56 manifests record the SHA-256 of each source
# file, and line-ending normalization would break both sums.
tools/win/wsi-dxgi/*.cpp -text

# The helper build receipt records these source bytes. Keep them stable across host checkouts.
tools/win/kmd-deploy/template/kmd168-transition/** -text

# The present-mode test fixture is one second of a real xperf dumper text, kept byte for byte with
# its CRLF endings: it is evidence of the shapes this driver produces.
tools/win/etw/testdata/*.txt -text

# PAM benchmark captures contain binary pixel payloads.
*.pam binary

# The guide character art is embedded in the application byte for byte. The SHA-256 of every file is listed in
# PROVENANCE.md beside it and the build compares the files against that list, so no checkout may rewrite a byte.
tools/win/amdgpu_wddm_control/art/nagi/*.png binary

# The Nagi wallpaper is an obfuscated container (art/wallpaper/PROVENANCE.md). Its SHA-256 is pinned there and in the
# unit tests, so no checkout may rewrite a byte.
tools/win/amdgpu_wddm_control/art/wallpaper/*.nwp binary

# The pictures of the README are stored byte for byte. The animation is an animated WebP, which no checkout
# may normalize.
docs/media/** binary

# The GDI compute kernels are an input of a hash: driver/kmd/gdi_kernels.generated.h records the
# SHA-256 of gdi_kernels.cl and gdi_pixel.h, and tools/gpu/gdi_kernels.py --check compares it with
# the files in the tree. They are stored with LF line endings, so that every checkout gives the
# bytes that hash names and a fresh worktree does not fail the gate.
*.cl text eol=lf

# HIP device sources are stored with LF line endings, so that a rebuild of a committed
# code object compiles the same bytes on every checkout.
*.hip text eol=lf

# The HIP test fixtures are hash pinned: compute/hip/tests/data/PROVENANCE.txt and
# PROVENANCE-runtime.txt record the SHA-256 of every file of that directory, and
# build.ps1 -Rebuild and build-runtime.ps1 -Rebuild compare the device artifacts byte for
# byte. Line-ending normalization would break those sums on checkout. This rule is the last
# match, so it also holds the .hip fixtures of that directory byte for byte.
compute/hip/tests/data/** -text

# The Ollama patches are applied with git apply to an upstream tree whose CMakeLists.txt has CRLF lines, and
# compute/ollama/build-ollama.ps1 records the SHA-256 of each patch: they are stored byte for byte.
compute/ollama/patches/** -text

# The imported AMD display reference sources are hash pinned: driver/shim/dml201/reference/manifest.json,
# driver/shim/dml201/reference/pipe/manifest.json and the extractors under tools/import compare their SHA-256
# with the files. They are stored byte for byte, so a checkout gives the bytes the hashes name.
driver/shim/dml201/reference/** -text
driver/amdgpu-import/reference/** -text

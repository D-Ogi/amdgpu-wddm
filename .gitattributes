* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.cfg  text eol=lf
*.conf text eol=lf
*.h    text eol=lf
*.c    text eol=lf
*.patch text eol=lf
*.ps1  text eol=crlf
# Shell scripts without an extension that run on the diagnostic USB
tools/diagusb/overlay/** text eol=lf
# A gate reads this list and a tool rewrites it: one line ending, on every machine
tools/quality/guardlog_width_baseline.txt text eol=lf
# Evidence is stored byte for byte, never normalized
evidence/** -text

# PAM benchmark captures contain binary pixel payloads.
*.pam binary

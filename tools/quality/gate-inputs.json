    "surface-control",
    "umd-analysis",
    "kmd-deploy"
  ],
  "groups": {
    "host": [
      {
        "root": "repo",
        "globs": [
          "driver/**/*",
          "tools/**/*",
          "third_party/**/*"
        ],
        "exclude": [
          "driver/kmd/umd_blob.c"
        ]
      }
    ],
    "documents": [
      {
        "root": "repo",
        "globs": [
          "docs/**/*",
          "README.md",
          "tools/**/*",
          "driver/**/*.md",
          "third_party/**/*"
        ]
      }
    ],
    "firmware": [
      {
        "root": "workspace",
        "globs": [
          "ref/linux-firmware__WARN-AMD-blobs-never-commit/amdgpu/cyan_skillfish2*.bin"
        ]
      }
    ],
    "blob-reader": [
      {
        "root": "repo",
        "globs": [
          "driver/kmd/umd_blob.c"
        ]
      }
    ]
  },
  "toolchain": [
    {
      "root": "compiler",
      "globs": [
        "bin/Hostx64/x64/**/*",
        "include/**/*",
        "lib/x64/**/*"
      ]
    },
    {
      "root": "kits",
      "globs": [
        "microsoft.windows.wdk.x64/c/Include/**/*",
        "microsoft.windows.wdk.x64/c/Lib/10.0.26100.0/km/x64/*",
        "microsoft.windows.sdk.cpp/c/Include/**/*",
        "microsoft.windows.sdk.cpp.x64/c/um/x64/*",
        "microsoft.windows.sdk.cpp.x64/c/ucrt/x64/*"
      ]
    }
  ],

  "control_app_exe": "amdgpu_wddm_control.exe",
  "mft_h264": {
    "note": "The H.264 encoder Media Foundation transform (M15.11). register true: the installer copies payload/mft/amdgpu_wddm_mft_h264.dll to <install root>\\mft\\ and writes route A of driver/umd/mft-h264/INSTALL.md machine wide. register false: the installer installs and registers nothing, and takes away what an earlier install of this release family wrote. The value travels into manifest.json, so the package itself says what it does. This is the bisect lever of the encoder wagon.",
    "register": true,
    "package_path": "payload/mft/amdgpu_wddm_mft_h264.dll",
    "clsid": "{A32438F0-0D79-4CA9-A5BF-9F3C80837253}",
    "friendly_name": "BC-250 H.264 Encoder MFT"
  },
  "sources": {
    "kmd": "bc250-win 8433a001 (kmd207-train, the one b18 train driver)",
    "d3d12_shell": "bc250-win m15/d3d12-iflip 694e6bac",
    "d3d12_engine": "vkd3d-proton fork amdgpu-wddm/upstream-2026-10-05 4e9a98e9, with dxil-spirv d2d82332",
    "d3d12_icd": "mesa fork amdgpu-wddm/disk-cache-single-file 091ad563",
    "d3d11_shell": "bc250-win m14/d3d11-iflip f93521ec",
    "d3d11_engine": "dxvk fork amdgpu-wddm/upstream-2026-10-05 5611118e",
    "d3d11_icd": "mesa fork amdgpu-wddm/disk-cache-single-file 091ad563",
    "wow64": "x86 builds for 32-bit processes (BD-064): router amdgpu-wddm wow64/router-x86 (631d25da + x86 patch), CPU UMD mesa 43d0907c, D3D11 shell amdgpu-wddm f93521ec + x86 patch 02560EAD, engine dxvk 5611118e, ICD mesa 091ad563 + x86 patch 9C645734; no x86 D3D12",
    "mft_h264": "bc250-win 70b6f838 (m15/video-encode-mft), the H.264 encoder transform",
    "firmware": "linux-firmware 2b8daaf611fbade74f26a5b58ec1defe6a02f5e0, downloaded by the installer"
  },
  "public_commits": {
    "note": "Built commit -> commit on a public branch, for every pair that differs. b18 has no such pair: each commit this release was built from is published at its own hash (D-Ogi/amdgpu-wddm kmd207-train 8433a001, m15/d3d12-iflip 694e6bac, m14/d3d11-iflip f93521ec, m15/video-encode-mft 70b6f838; D-Ogi/dxvk, D-Ogi/vkd3d-proton and D-Ogi/dxil-spirv on branch amdgpu-wddm/upstream-2026-10-05; D-Ogi/mesa-amdgpu-wddm 091ad563 on branch amdgpu-wddm/disk-cache-single-file, the ICD b17 shipped). The b17 pairs were 2e61d1fe -> 6c8c31c9, 36745de5 -> 7b8347ba, 7294c09d -> af01d499 and dd30a44d -> 9a6f26d2."
  },

#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint SEED = 0;
layout(std430, set = 0, binding = 0) buffer Data { uint data[]; } b;

uint mixw(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16; return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 1024) return;
    b.data[i] = mixw(i ^ SEED);
}

+/* Success records must retain module bases too. The CPU is sampled here, not at an earlier fault. */
+static void
+bd201_identity_string(const char *s)
+{
+   putchar('"');
+   for (const unsigned char *p = (const unsigned char *)s; *p; ++p) {
+      if (*p == '"' || *p == '\\') printf("\\%c", *p);
+      else if (*p < 32) printf("\\u%04x", (unsigned)*p);
+      else putchar(*p);
+   }
+   putchar('"');
+}
+
+static DWORD
+bd201_identity_sha256(const char *path, char digest[65])
+{
+   HANDLE file = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                            NULL, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+   if (file == INVALID_HANDLE_VALUE) return GetLastError();
+   BCRYPT_ALG_HANDLE alg = NULL;
+   BCRYPT_HASH_HANDLE hash = NULL;
+   NTSTATUS status = BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, NULL, 0);
+   if (status >= 0) status = BCryptCreateHash(alg, &hash, NULL, 0, NULL, 0, 0);
+   unsigned char block[16384], raw[32];
+   DWORD error = 0, got = 0;
+   while (status >= 0) {
+      if (!ReadFile(file, block, sizeof(block), &got, NULL)) { error = GetLastError(); break; }
+      if (!got) {
+         status = BCryptFinishHash(hash, raw, sizeof(raw), 0);
+         if (status >= 0) {
+            static const char hex[] = "0123456789abcdef";
+            for (unsigned i = 0; i < 32; ++i) { digest[i * 2] = hex[raw[i] >> 4]; digest[i * 2 + 1] = hex[raw[i] & 15]; }
+            digest[64] = '\0';
+         }
+         break;
+      }
+      status = BCryptHashData(hash, block, got, 0);
+   }
+   if (status < 0) error = (DWORD)status;
+   if (hash) BCryptDestroyHash(hash);
+   if (alg) BCryptCloseAlgorithmProvider(alg, 0);
+   CloseHandle(file);
+   return error;
+}
+
+static void
+bd201_record_identity(const char *stage)
+{
+   HMODULE modules[512];
+   DWORD needed = 0;
+   const BOOL modules_ok = K32EnumProcessModules(GetCurrentProcess(), modules, sizeof(modules), &needed);
+   const DWORD modules_error = modules_ok ? 0 : GetLastError();
+   PROCESSOR_NUMBER cpu;
+   GetCurrentProcessorNumberEx(&cpu);
+   DWORD_PTR process_mask = 0, system_mask = 0;
+   const BOOL affinity_ok = GetProcessAffinityMask(GetCurrentProcess(), &process_mask, &system_mask);
+   const DWORD affinity_error = affinity_ok ? 0 : GetLastError();
+   GROUP_AFFINITY group;
+   memset(&group, 0, sizeof(group));
+   const BOOL group_ok = GetThreadGroupAffinity(GetCurrentThread(), &group);
+   const DWORD group_error = group_ok ? 0 : GetLastError();
+   printf("bd201scratch: identity {\"stage\":");
+   bd201_identity_string(stage);
+   printf(",\"pid\":%lu,\"tid\":%lu,\"tick_ms\":%llu,\"processor_at_snapshot\":{\"group\":%u,\"number\":%u},"
+          "\"process_affinity\":{\"ok\":%s,\"error\":%lu,\"process_mask\":\"0x%llx\",\"system_mask\":\"0x%llx\"},"
+          "\"thread_group_affinity\":{\"ok\":%s,\"error\":%lu,\"group\":%u,\"mask\":\"0x%llx\"},"
+          "\"modules_ok\":%s,\"modules_error\":%lu,\"modules_truncated\":%s,\"modules\":[",
+          GetCurrentProcessId(), GetCurrentThreadId(), (unsigned long long)GetTickCount64(),
+          (unsigned)cpu.Group, (unsigned)cpu.Number, affinity_ok ? "true" : "false", affinity_error,
+          (unsigned long long)process_mask, (unsigned long long)system_mask,
+          group_ok ? "true" : "false", group_error, (unsigned)group.Group, (unsigned long long)group.Mask,
+          modules_ok ? "true" : "false", modules_error, needed > sizeof(modules) ? "true" : "false");
+   unsigned count = modules_ok ? needed / sizeof(HMODULE) : 0;
+   if (count > 512) count = 512;
+   unsigned printed = 0;
+   for (unsigned i = 0; i < count; ++i) {
+      char path[32768];
+      const DWORD n = GetModuleFileNameA(modules[i], path, sizeof(path));
+      if (!n || n >= sizeof(path)) continue;
+      const char *name = strrchr(path, '\\');
+      name = name ? name + 1 : path;
+      const size_t len = strlen(name);
+      if (_strnicmp(name, "amdgpu_wddm", 11) || len < 4 || _stricmp(name + len - 4, ".dll")) continue;
+      MODULEINFO info;
+      memset(&info, 0, sizeof(info));
+      const BOOL info_ok = K32GetModuleInformation(GetCurrentProcess(), modules[i], &info, sizeof(info));
+      const DWORD info_error = info_ok ? 0 : GetLastError();
+      char digest[65] = "";
+      const DWORD hash_error = bd201_identity_sha256(path, digest);
+      if (printed++) putchar(',');
+      printf("{\"name\":"); bd201_identity_string(name);
+      printf(",\"base\":\"0x%llx\",\"size\":\"0x%llx\",\"info_ok\":%s,\"info_error\":%lu,\"sha256\":\"%s\",\"hash_error\":%lu}",
+             (unsigned long long)(ULONG_PTR)modules[i], (unsigned long long)info.SizeOfImage,
+             info_ok ? "true" : "false", info_error, digest, hash_error);
+   }
+   printf("]}\n");
+   fflush(stdout);
+}
+
+static void
+bd201_record_first_submit(void)
+{
+   static volatile LONG recorded = 0;
+   if (InterlockedCompareExchange(&recorded, 1, 0) == 0)
+      bd201_record_identity("after-first-submit");
+}

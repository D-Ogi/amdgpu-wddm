# L7: firmware (GOP) framebuffer and memory-controller state before amdgpu, and GART context 0 after it.
# Offsets: tools/regcalc/regcalc.py with third_party/linux-amdgpu dcn_2_0_1_offset.h (--ip DMU),
# gc_10_1_0_offset.h (--ip GC), mmhub_2_0_0_offset.h (--ip MMHUB); DCN rows copied from
# scratch/linux-1031/dcn-pipe01.regs (same tool). Pipe 0 only: the GOP drives one pipe; pipe 1 may be gated.
# No indexed data port, no *_DATA register.
HUBPREQ0_DCSURF_PRIMARY_SURFACE_ADDRESS        0x0EB28

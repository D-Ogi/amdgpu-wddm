+/* LDS spill slots need the same ordering as scratch spill slots. Without memory_sync_info,
+ * a DS instruction has storage_none, so the scheduler treats it as non-aliasing and can move
+ * a reload above the spill that writes the same slot.
+ */
+void
+emit_lds_spill(spill_ctx& ctx, Builder& bld, Temp temp, unsigned lds_offset)
+{
+   Instruction* instr =
+      bld.ds(aco_opcode::ds_write_addtid_b32, bld.m0(ctx.lds_m0_zero), temp, lds_offset);
+   instr->ds().sync = memory_sync_info(storage_vgpr_spill, semantic_private);
+}
+
+void
+emit_lds_reload(spill_ctx& ctx, Builder& bld, Definition def, unsigned lds_offset)
+{
+   Instruction* instr =
+      bld.ds(aco_opcode::ds_read_addtid_b32, def, bld.m0(ctx.lds_m0_zero), lds_offset);
+   instr->ds().sync = memory_sync_info(storage_vgpr_spill, semantic_private);
+}

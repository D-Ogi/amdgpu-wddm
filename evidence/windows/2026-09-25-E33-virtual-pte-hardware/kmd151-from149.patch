-    u64* tables;
-    u32* ib;
-    UCHAR *sourceA,*sourceB,*dest;
-    ULONG i,trial,vram,gtt,seq=0,arrived=0,waited;
-    unsigned int fillDw,copyDw,length;
-    int result=0;

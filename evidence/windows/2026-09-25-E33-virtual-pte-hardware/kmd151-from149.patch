-    else if (result == BC250_SDMA_PAGING_INSUFFICIENT) status = STATUS_GRAPHICS_INSUFFICIENT_DMA_BUFFER;
-    else status = STATUS_INVALID_PARAMETER;
-Done:
-    ExReleasePushLockShared(&Device->GfxPagingLock);
-    KeLeaveCriticalRegion();
-    return status;
-}

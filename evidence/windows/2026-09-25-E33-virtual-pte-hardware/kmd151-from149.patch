-    } else result=PagingEmit(&stream,(unsigned*)Buffer,budget,srcMc,dstMc,Bytes,&written);
-    if (result==BC250_SDMA_PAGING_INSUFFICIENT) {status=STATUS_GRAPHICS_INSUFFICIENT_DMA_BUFFER;goto Done;}

-    BC250_GFX* gfx;
-    ULONGLONG progress,startVa,begin;
-    unsigned budget,minimum,capacity,used=0,next=Token;
-    u32* ib;
-    NTSTATUS status=STATUS_INVALID_PARAMETER;

-{
-    const u64 baseVa=0x40000000ULL;
-    BC250_GFX* gfx=(BC250_GFX*)Device->Gfx;
-    struct amdgpu_device* adev=NULL;
-    struct amdgpu_ring* ring;
-    void* previousBackend;
-    BOOLEAN enabled=FALSE;
-    NTSTATUS status;

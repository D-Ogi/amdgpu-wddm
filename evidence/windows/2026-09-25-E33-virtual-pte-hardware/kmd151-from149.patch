-        gfx->SubmitFailed || gfx->PagingSubmitFailed ||
-        gfx->SubmitInFlight || gfx->PagingSubmitInFlight) goto Done;
-    if (!Initialized) {
-        ready=!gfx->SetUp && gfx->StagesDone==0 && gfx->PagingCpuBootstrap;

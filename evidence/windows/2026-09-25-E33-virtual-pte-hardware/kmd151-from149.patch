+static ULONG Microseconds(LARGE_INTEGER From, LARGE_INTEGER Frequency)
+{
+    LARGE_INTEGER now = KeQueryPerformanceCounter(NULL);
+
+    return (ULONG)(((now.QuadPart - From.QuadPart) * 1000000ll) / Frequency.QuadPart);
+}

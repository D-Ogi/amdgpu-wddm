+
+#define RM_WDDM_ROOTS 4u
+#define RM_IB 0xFFu                         /* the job of the IB_AT escape, at its own root */
+#define RM_IB_ROOT 0x9000ull
+
+/* A model of SubmitIbLocked with the ring gate on, and of what the CP then does with the frame. The hardware part
+ * of the model is the page-table base register of each VMID and the translations in the TLB of each VMID. Each
+ * translation has a tag: the root, the process and the version of the tables that the walker read it from. When a
+ * job starts at its VMID, the register must hold the root of the job. The TLB must not hold a translation of
+ * another root, of another process or of an older version of the tables of the job. */
+typedef struct {
+    MODEL M;
+    int EveryJob;
+    unsigned long long HwRoot[BC250_VMID_COUNT];
+    int TlbFull[BC250_VMID_COUNT];
+    unsigned long long TlbRoot[BC250_VMID_COUNT];
+    unsigned long TlbProcess[BC250_VMID_COUNT];
+    unsigned TlbGen[BC250_VMID_COUNT];
+    unsigned long Owner[RM_WDDM_ROOTS];     /* the process that owns the tables at WDDM root r */
+    unsigned Gen[RM_WDDM_ROOTS];            /* the version of those tables: equal versions, equal translations */
+    unsigned IbGen;                         /* the version of the IB_AT tables, written again before every job */
+    unsigned GenClock;                      /* gives each new version a number that no version had before */
+    unsigned long NextProcess;
+    unsigned long Flushes, Skips, Refused;
+} RING_MODEL;
+
+static void RingInit(RING_MODEL* r, unsigned members, unsigned long firstSeq, int everyJob)
+{
+    unsigned i;
+    memset(r, 0, sizeof(*r));
+    ModelInit(&r->M, members, firstSeq);
+    r->EveryJob = everyJob;
+    for (i = 0; i < RM_WDDM_ROOTS; i++) { r->Owner[i] = 100u + i; r->Gen[i] = ++r->GenClock; }
+    r->NextProcess = 1000;
+    /* The hardware holds unknown values from before this engine instance. The model trusts none of them. */
+    for (i = 0; i < BC250_VMID_COUNT; i++) {
+        r->HwRoot[i] = 0xDEAD000ull + i;
+        r->TlbFull[i] = 1; r->TlbRoot[i] = 0xBADull; r->TlbProcess[i] = 0xBAD; r->TlbGen[i] = 0xBAD;
+    }
+}
+
+static int RingStale(const RING_MODEL* r, unsigned v, unsigned long long root, unsigned long process, unsigned gen)
+{
+    return r->TlbFull[v] && (r->TlbRoot[v] != root || r->TlbProcess[v] != process || r->TlbGen[v] != gen);
+}
+
+/* Which is RM_IB or the index of a WDDM root. Requested is AUTO, or the explicit VMID of the IB_AT escape. With
+ * Refuse 1, the emitter refuses after the claim, before it commits a dword. Returns the verdict, or -1 when the
+ * model has no space for one more job in flight. */
+static int RingSubmit(RING_MODEL* r, unsigned which, unsigned requested, int refuse)
+{
+    MODEL* m = &r->M;
+    BC250_VMID_DECISION d;
+    unsigned long long root;
+    unsigned long process;
+    unsigned gen;
+    int flush;
+
+    if (m->PendingCount >= MODEL_PENDING_MAX) return -1;
+    if (which == RM_IB) { root = RM_IB_ROOT; process = 0; gen = r->IbGen = ++r->GenClock; } /* no FLUSH_TLB */
+    else { root = 0x1000ull * (which + 1u); process = r->Owner[which]; gen = r->Gen[which]; }
+    Bc250VmidSweep(&m->Table, m->Completed);
+    d = Bc250VmidAdmit(&m->Table, m->Members, 1, requested, root, m->PendingCount != 0, m->LastVmid, m->Completed);
+    if (requested == BC250_VMID_AUTO) CHECK(d.Verdict != BC250_VMID_REFUSE_RULE);
+    if (d.Verdict != BC250_VMID_ADMIT) return d.Verdict;            /* refused before anything changed */
+    flush = Bc250VmidRingFlushNeeded(&m->Table, requested, r->EveryJob, d.Vmid, d.Claim, root, process);
+    if (d.Claim) Bc250VmidClaim(&m->Table, &m->History, d.Vmid, root);
+    if (refuse) { r->Refused++; return BC250_VMID_REFUSE_BUSY; }   /* nothing committed, the claim stands */
+    if (flush) { r->HwRoot[d.Vmid] = root; r->TlbFull[d.Vmid] = 0; r->Flushes++; }
+    else r->Skips++;
+    CHECK(r->HwRoot[d.Vmid] == root);                               /* the job walks its own root */
+    CHECK(!RingStale(r, d.Vmid, root, process, gen));               /* and no translation that it must not see */
+    r->TlbFull[d.Vmid] = 1; r->TlbRoot[d.Vmid] = root; r->TlbProcess[d.Vmid] = process; r->TlbGen[d.Vmid] = gen;
+    if (++m->NextSeq == 0) m->NextSeq = 1;
+    Bc250VmidSubmitted(&m->Table, d.Vmid, m->NextSeq, process);
+    if (flush) Bc250VmidRingFlushed(&m->Table, d.Vmid, root, process);
+    m->Pending[m->PendingCount].Seq = m->NextSeq;
+    m->Pending[m->PendingCount].Vmid = d.Vmid;
+    m->Pending[m->PendingCount].Root = root;
+    m->PendingCount++;
+    m->LastVmid = d.Vmid;
+    return BC250_VMID_ADMIT;
+}
+
+/* VidMm changes the tables of WDDM root r and sends FLUSH_TLB for that root. The paging buffer invalidates each VMID
+ * in Bc250VmidFlushMask (GfxPagingBuildFlush) before a job that depends on the change can run. */
+static void RingPageTables(RING_MODEL* r, unsigned which)
+{
+    unsigned mask = Bc250VmidFlushMask(&r->M.Table, r->M.Members, 0x1000ull * (which + 1u)), v;
+    r->Gen[which] = ++r->GenClock;
+    for (v = 0; v < BC250_VMID_COUNT; v++) if (mask & (1u << v)) r->TlbFull[v] = 0;
+}
+
+/* The second protection: the page of root r is freed with its process, and the next process gets a root at the
+ * same address. This model sends no FLUSH_TLB for the new tables. The event occurs only after the jobs of the old
+ * process retired, because VidMm frees the tables of a process only then. */
+static int RingNewProcess(RING_MODEL* r, unsigned which)
+{
+    unsigned i;
+    for (i = 0; i < r->M.PendingCount; i++) if (r->M.Pending[i].Root == 0x1000ull * (which + 1u)) return 0;
+    r->Owner[which] = ++r->NextProcess;
+    r->Gen[which] = ++r->GenClock;
+    return 1;
+}
+
+/* VidMm moves the root of the process at root A to the address of root B (SetRootPageTable). Neither root has a job
+ * in flight. A new process gets the page of root A. The move copies the root, so the translations of the process
+ * do not change, and the version moves with the process. This model sends no FLUSH_TLB. The process stays the same,
+ * and only its root changes. In this case, only RingRoot shows that the register of a VMID holds an older root than
+ * the table. */
+static int RingMoveRoot(RING_MODEL* r, unsigned from, unsigned to)
+{
+    unsigned i;
+    if (from == to) return 0;
+    for (i = 0; i < r->M.PendingCount; i++)
+        if (r->M.Pending[i].Root == 0x1000ull * (from + 1u) || r->M.Pending[i].Root == 0x1000ull * (to + 1u)) return 0;
+    r->Owner[to] = r->Owner[from];
+    r->Gen[to] = r->Gen[from];
+    r->Owner[from] = ++r->NextProcess;
+    r->Gen[from] = ++r->GenClock;
+    return 1;
+}
+
+/* A teardown or a retained resume (Bc250VmidResetAll), or a soft recovery (Bc250VmidRingForget). Both find the ring
+ * idle. After each of them, the model trusts nothing that the hardware holds. A reset also loses the registers. */
+static void RingReset(RING_MODEL* r, int resetAll)
+{
+    unsigned v;
+    while (ModelRetire(&r->M)) {}
+    if (resetAll) Bc250VmidResetAll(&r->M.Table, &r->M.History);
+    else Bc250VmidRingForget(&r->M.Table);
+    for (v = 0; v < BC250_VMID_COUNT; v++) {
+        if (resetAll) r->HwRoot[v] = 0xDEAD000ull + v;
+        r->TlbFull[v] = 1; r->TlbRoot[v] = 0xBADull; r->TlbProcess[v] = 0xBAD; r->TlbGen[v] = 0xBAD;
+    }
+}
+
+static unsigned long g_ringLeaves;
+
+static void RingExplore(const RING_MODEL* r, unsigned depth)
+{
+    unsigned op;
+    if (depth == 0) { g_ringLeaves++; return; }
+    for (op = 0; op < 10; op++) {
+        RING_MODEL next = *r;
+        switch (op) {
+        case 0: if (RingSubmit(&next, 0, BC250_VMID_AUTO, 0) < 0) continue; break;
+        case 1: if (RingSubmit(&next, 1, BC250_VMID_AUTO, 0) < 0) continue; break;
+        case 2: if (RingSubmit(&next, 1, BC250_VMID_AUTO, 1) < 0) continue; break;     /* emitter refused */
+        case 3: if (RingSubmit(&next, RM_IB, 3, 0) < 0) continue; break;              /* IB_AT at VMID 3 */
+        case 4: if (!ModelRetire(&next.M)) continue; break;
+        case 5: RingPageTables(&next, 0); break;
+        case 6: if (!RingNewProcess(&next, 1)) continue; break;
+        case 7: if (!RingMoveRoot(&next, 0, 1)) continue; break;
+        case 8: RingReset(&next, 1); break;
+        default: RingReset(&next, 0); break;
+        }
+        CHECK(ModelSafe(&next.M));
+        if (bad > 20) return;
+        RingExplore(&next, depth - 1u);
+    }
+}
+
+static void TestRingFlushModel(void)
+{
+    static const unsigned pools[] = { (1u << 1) | (1u << 3), (1u << 1) | (1u << 3) | (1u << 4) };
+    unsigned p, seed;
+    RING_MODEL r;

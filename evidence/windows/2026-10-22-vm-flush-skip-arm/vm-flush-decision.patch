+    CHECK(!Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 0, 0xA000, 4242));
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 1, 3, 0, 0xA000, 4242));    /* EnableVmFlushEveryJob 1 */
+    CHECK(Bc250VmidRingFlushNeeded(&t, 3, 0, 3, 0, 0xA000, 4242));                  /* an explicit VMID: IB_AT */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 1, 0xA000, 4242));    /* a claim */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 0, 0xB000, 4242));    /* another root */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 0, 0xA000, 4243));    /* another process */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 0, 0xA000, 0));       /* no identity */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 4, 0, 0xA000, 4242));    /* another VMID */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 16, 0, 0xA000, 4242));   /* not a VMID */
+    /* A root of 0 never counts as written, because RingRoot 0 means "nothing". */
+    Bc250VmidRingFlushed(&t, 5, 0, 4242);
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 5, 0, 0, 4242));
+    /* The forget of the soft recovery: the tenancies stay, and every VMID flushes again. */
+    t.Root[3] = 0xA000;
+    Bc250VmidRingForget(&t);
+    CHECK(t.Root[3] == 0xA000 && t.RingRoot[3] == 0 && t.RingProcess[3] == 0);
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 0, 0xA000, 4242));

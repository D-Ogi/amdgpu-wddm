+/* ---- the ring VM flush decision, against a model of the register and the TLB of each VMID -------------------- */
+
+/* The decision alone, one clause at a time (vmid_pool.h, Bc250VmidRingFlushNeeded). */
+static void TestRingFlushDecision(void)
+{
+    BC250_VMID_TABLE t;
+
+    memset(&t, 0, sizeof(t));
+    /* The ring wrote nothing yet, so every VMID flushes, whatever the other arguments are. */
+    CHECK(Bc250VmidRingFlushNeeded(&t, BC250_VMID_AUTO, 0, 3, 0, 0xA000, 4242));
+    Bc250VmidRingFlushed(&t, 3, 0xA000, 4242);
+    CHECK(t.RingRoot[3] == 0xA000 && t.RingProcess[3] == 4242);

+                else if (e < 94) (void)RingNewProcess(&r, Rand(RM_WDDM_ROOTS));
+                else if (e < 98) (void)RingMoveRoot(&r, Rand(RM_WDDM_ROOTS), Rand(RM_WDDM_ROOTS));

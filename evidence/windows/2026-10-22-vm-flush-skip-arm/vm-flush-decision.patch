index 01dd60f0..9f9c6e26 100644
--- a/driver/kmd/vmid_pool.h
+++ b/driver/kmd/vmid_pool.h
@@ -9,8 +9,9 @@
  * With the pool, a root gets a VMID of its own and keeps it while it keeps submitting:
  *
  *   1. A pool VMID that already holds the job's root is used again, whatever is in flight on it. The root does not
- *      change, so nothing can be redirected. (The per-submit invalidation still runs, as it always did: it is what
- *      picks up a leaf-PTE change made under an unchanged root.)
+ *      change, so nothing can be redirected. With the ring VM flush, the job invalidates its VMID only when
+ *      Bc250VmidRingFlushNeeded says so. After a leaf-PTE change under an unchanged root, VidMm sends FLUSH_TLB,
+ *      and the paging buffer invalidates the VMID. amdgpu uses vm->tlb_seq for the same purpose.
  *   2. Otherwise the least recently used pool VMID whose last job has retired is claimed and given the root.
  *   3. Otherwise there is no VMID to give, and the caller gets STATUS_DEVICE_BUSY, which is the old behaviour.
  *
@@ -49,6 +50,8 @@ typedef struct BC250_VMID_TABLE {
     unsigned long FirstSeq[BC250_VMID_COUNT];    /* the current tenant's first job; 0 = none submitted yet */
     unsigned long LastSeq[BC250_VMID_COUNT];     /* the current tenant's newest job, kept after it retired */
     unsigned long Process[BC250_VMID_COUNT];     /* the process of the current tenant's newest job */
+    unsigned long long RingRoot[BC250_VMID_COUNT]; /* the root of the newest committed ring VM flush, 0 = none */
+    unsigned long RingProcess[BC250_VMID_COUNT];   /* the process of that flush, 0 = none or no identity */
 } BC250_VMID_TABLE;
 
 /* One tenancy that ended: a VMID given a different root, or the table reset by a teardown. */
@@ -261,6 +264,79 @@ static __inline unsigned Bc250VmidFlushMask(const BC250_VMID_TABLE* Table, unsig
     return mask ? mask : (1u << BC250_VMID_LEGACY);
 }
 
+/* Bc250VmidRingFlushNeeded says whether the frame of a job carries the ring VM flush: the root write and the
+ * invalidation of its VMID. The caller asks only with EnableRingVmFlush 1. With EnableRingVmFlush 0, the MMIO path
+ * flushes the VMID before every job.
+ *
+ * amdgpu (linux v6.18 7d0a66e4) flushes the VMID of a job only in these cases:
+ *   - The VM gets a VMID that it does not own (amdgpu_ids.c:354 and :433).
+ *   - The tlb_seq of the VM increased after the last flush of the VMID (:365). An unmap, a BO move and a PDE move
+ *     increase tlb_seq.
+ *   - The CPU writes the page tables of the VM (:347, use_cpu_for_update).
+ *   - The last flush of the VMID is not emitted yet, or it ran on another ring and did not signal yet (:360).
+ *   - A GPU reset occurred (amdgpu_vm.c:788).
+ * In all other cases, the next job of the same VM at the same VMID runs without a VM flush.
+ *
+ * This driver replaces each amdgpu case as follows:
+ *   - tlb_seq: VidMm sends FLUSH_TLB. The KMD does not set DXGK_GPUMMUCAPS::InvalidTlbEntriesNotCached, so VidMm
+ *     also sends FLUSH_TLB for the VA ranges that change from invalid to valid (d3dkmddi.h, WDK 10.0.26100). The
+ *     paging buffer then invalidates each VMID in Bc250VmidFlushMask: each VMID that holds a root and each pool
+ *     member. It does this before the paging fence that dependent work waits for (gfx.c, GfxPagingBuildFlush).
+ *     The documentation does not say whether FLUSH_TLB also follows COPY_PAGE_TABLE_ENTRIES (tile mappings).
+ *     EnableVmFlushEveryJob 1 is the rollback for that case.
+ *   - CPU writes: the CPU_VIRTUAL updates write only the tables of the paging process, at adapter start and at
+ *     power-on (system-paging-process.md). That process runs at VMID 2 on node 1, never at a pool VMID. The tables
+ *     of applications are GPU_PHYSICAL updates in paging buffers (WddmGpuMmuCaps).
+ *   - Another ring: only the gfx ring runs jobs at these VMIDs. A flush on the gfx ring comes before each later job
+ *     in ring order.
+ *   - A reset: the next job of each VMID flushes after Bc250VmidResetAll (teardown, retained resume) and after
+ *     Bc250VmidRingForget (soft recovery).
+ *
+ * The function returns 1 (flush) when one of these conditions is true:
+ *   - EveryJob is 1. EnableVmFlushEveryJob 1 makes every job flush, as in 0.7.216.65 and earlier releases.
+ *   - Requested is an explicit VMID. The IB_AT escape names its own root and can change its own page tables
+ *     without FLUSH_TLB, so every IB_AT job flushes.
+ *   - Claim is 1. Bc250VmidAdmit gave this root to the VMID for this job.
+ *   - The RingRoot of the VMID is 0 or is not Root. RingRoot is the root of the newest committed ring flush, or 0
+ *     when no flush was committed after the last reset. A refused emission does not change RingRoot. After a claim
+ *     with a refused emission, the Root of the table can differ from the root in the register. A RingRoot other
+ *     than 0 is always the root in the register.
+ *   - Process is 0 (unknown), or the RingProcess of the VMID is not Process. amdgpu compares the VM (the owner
+ *     fence context), not the address of the root. A process can free its root page, and the next process can get
+ *     a root at the same address. The jobs of the second process must not use the translations of the first
+ *     process. The FLUSH_TLB of VidMm for the new tables also prevents this. This condition is a second
+ *     protection. */
+static __inline int Bc250VmidRingFlushNeeded(const BC250_VMID_TABLE* Table, unsigned Requested, int EveryJob,
+                                             unsigned Vmid, int Claim, unsigned long long Root, unsigned long Process)
+{
+    if (Vmid >= BC250_VMID_COUNT) return 1;
+    return EveryJob || Requested != BC250_VMID_AUTO || Claim || Table->RingRoot[Vmid] == 0 ||
+           Table->RingRoot[Vmid] != Root || Process == 0 || Table->RingProcess[Vmid] != Process;
+}
+
+/* Call this only after a frame with the ring VM flush for Root was committed and the gfx sequence recorded no
+ * fault. The CP then writes Root into the register of the VMID and invalidates the VMID before the job, in ring
+ * order. Never call it for a refused emission. */
+static __inline void Bc250VmidRingFlushed(BC250_VMID_TABLE* Table, unsigned Vmid, unsigned long long Root,
+                                          unsigned long Process)
+{
+    if (Vmid >= BC250_VMID_COUNT) return;
+    Table->RingRoot[Vmid] = Root;
+    Table->RingProcess[Vmid] = Process;
+}
+
+/* Forget what the ring wrote. After this, the next job of each VMID writes its root and invalidates its VMID again.
+ * amdgpu also flushes each VMID once after a GPU reset (amdgpu_vmid_had_gpu_reset). The soft recovery calls this
+ * function, and the tenancies stay. Bc250VmidResetAll clears the same fields with the rest of the table. */
+static __inline void Bc250VmidRingForget(BC250_VMID_TABLE* Table)
+{
+    unsigned v;
+    for (v = 0; v < BC250_VMID_COUNT; v++) {
+        Table->RingRoot[v] = 0;
+        Table->RingProcess[v] = 0;
+    }
+}
+
 /* Who ran at Vmid: the current tenant (*Live, from the table) and the newest earlier tenancy of the same VMID
  * (*Before, from the history). Each flag says whether its record exists. A fault latch names a VMID, not a job,
  * and the job that faulted may belong to either: a latch read late can describe a VMID that was since recycled. */

From 1d7ac9ca4f11ce4bac287a71a38e221aa044c516 Mon Sep 17 00:00:00 2001
From: D-Ogi <6542335+D-Ogi@users.noreply.github.com>
Date: Sun, 27 Sep 2026 06:15:20 +0200
Subject: [PATCH] wsi/wddm2: log who owns VidPn source 0 when the present
 context is created

D3DKMTCheckVidPnExclusiveOwnership returns STATUS_GRAPHICS_VIDPN_SOURCE_IN_USE
when another client owns the source, the status wsi-kmt-003 measured on every
windowed Blt present. Printed once per process next to the context handle.
---
 src/amd/vulkan/winsys/wddm2/radv_wddm2_wsi.c   | 10 ++++++++++
 src/util/bc250_host_bootstrap.h                |  2 ++
 src/vulkan/util/vk_wddm2_dispatch_table_gen.py |  1 +
 3 files changed, 13 insertions(+)

diff --git a/src/amd/vulkan/winsys/wddm2/radv_wddm2_wsi.c b/src/amd/vulkan/winsys/wddm2/radv_wddm2_wsi.c
index 9f0902d8..c830a18f 100644
--- a/src/amd/vulkan/winsys/wddm2/radv_wddm2_wsi.c
+++ b/src/amd/vulkan/winsys/wddm2/radv_wddm2_wsi.c
@@ -100,6 +100,16 @@ radv_wddm2_wsi_present_context(struct radv_wddm2_winsys *ws, uint32_t *context_h
          result = VK_ERROR_SURFACE_LOST_KHR;
       } else {
          ws->wsi.present_context_h = create.hContext;
+         /* E45 diagnostic, once per process: a windowed Blt present is refused with
+          * STATUS_GRAPHICS_VIDPN_SOURCE_IN_USE while another client owns source 0.
+          * This query returns that same status when it does. */
+         D3DKMT_CHECKVIDPNEXCLUSIVEOWNERSHIP own = {
+            .hAdapter = ws->adapter_h,
+            .VidPnSourceId = 0,
+         };
+         NTSTATUS own_status = BC250_WDDM_CALL(&ws->host, CheckVidPnExclusiveOwnership, &own);
+         fprintf(stderr, "wddm2: present context 0x%x created; VidPn source 0 exclusive-ownership check 0x%X\n",
+                 create.hContext, own_status);
       }
    }
    *context_h = ws->wsi.present_context_h;
diff --git a/src/util/bc250_host_bootstrap.h b/src/util/bc250_host_bootstrap.h
index e2ab2649..afb278b7 100644
--- a/src/util/bc250_host_bootstrap.h
+++ b/src/util/bc250_host_bootstrap.h
@@ -89,6 +89,8 @@ static inline int bc250_host_fence_valid(const struct bc250_host *host, uint64_t
 /* WSI window present (D3DKMTPresent with Flags.Blt). Host version 5 does not serve it;
  * the hosted ICD keeps the CPU present path. */
 #define BC250_HOST_Present 45u
+/* Diagnostic next to the present context: who owns VidPn source 0 (E45). Not served by host version 5. */
+#define BC250_HOST_CheckVidPnExclusiveOwnership 46u
 #define BC250_WDDM_CALL(host, name, argument) \
    ((host)->dispatch ? (host)->dispatch((host)->userdata, BC250_HOST_##name, (void *)(argument)) : WDDM2_DISPATCH(name(argument)))
 #endif
diff --git a/src/vulkan/util/vk_wddm2_dispatch_table_gen.py b/src/vulkan/util/vk_wddm2_dispatch_table_gen.py
index 71a06ae3..33e18e8c 100644
--- a/src/vulkan/util/vk_wddm2_dispatch_table_gen.py
+++ b/src/vulkan/util/vk_wddm2_dispatch_table_gen.py
@@ -253,6 +253,7 @@ def main():
       ('DestroyHwQueue', None),
       ('SubmitCommand', None),
       ('Present', 'D3DKMT_PRESENT *arg'),
+      ('CheckVidPnExclusiveOwnership', 'const D3DKMT_CHECKVIDPNEXCLUSIVEOWNERSHIP *arg'),
       ('SubmitCommandToHwQueue', None),
       ('CreateAllocation2', 'D3DKMT_CREATEALLOCATION *arg'),
       ('DestroyAllocation2', None),
-- 

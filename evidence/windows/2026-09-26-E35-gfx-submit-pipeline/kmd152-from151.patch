-    for (i = 0; i < Bytes; i += 4)
-    {
-        Dst[i] = Src[i + 2]; Dst[i + 1] = Src[i + 1];
-        Dst[i + 2] = Src[i]; Dst[i + 3] = Src[i + 3];
-    }

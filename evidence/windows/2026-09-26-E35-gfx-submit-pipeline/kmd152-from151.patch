-    NT_ASSERT(device->GfxAccessUsers != 0);
-    if (--device->GfxAccessUsers == 0) KeSetEvent(&device->GfxAccessDrained, IO_NO_INCREMENT, FALSE);
-    KeReleaseSpinLock(&device->GfxAccessLock, irql);
-}

-    for (i=0;i<Adev->gfx.num_gfx_rings;i++) GfxResetRetainedRing(&Adev->gfx.gfx_ring[i]);
-    for (i=0;i<(ULONG)Adev->sdma.num_instances;i++) GfxResetRetainedRing(&Adev->sdma.instance[i].ring);

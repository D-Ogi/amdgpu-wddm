-    Gfx->PowerSuspended=FALSE;
-    for (stage=1;stage<=BC250_GFX_STAGE_INTERRUPTS;stage++) {
-        // RLC rewrites its private VRAM CSB; CP rebuilds VRAM MQDs at the same

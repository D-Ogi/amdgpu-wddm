-                            _Inout_ PVOID DmaBuffer, ULONG DmaBufferOffset, ULONG DmaBufferFree,
-                            _Out_ ULONG* DwordsWritten,
-                            _Out_ BC250_WDDM_PAGING_UNSUPPORTED* Unsupported)
-{
-    BC250_GFX* gfx;

-void GfxPagingSubmitFail(_Inout_ BC250_DEVICE* Device)
-{
-    StartHealthFault(Device);
-    if (GfxAccessAcquire(Device) == NULL)
-    {
-        return;
-    }
-    GfxPagingSubmitFailAccess(Device);
-    GfxAccessRelease(Device);

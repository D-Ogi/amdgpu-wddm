-    // transaction. Ask the real packet builder for its aligned cost without writes.
-    result=PagingEmit(&stream,(unsigned*)Buffer,0,sources[0]|PAGING_SYSTEM_ADDRESS,
-        gfx->PagingCopyStaging.mc,PAGE_SIZE,&required);

-// ---- fences (E12 part C) ------------------------------------------------------------------------------------------------
-
-static struct amdgpu_ring* FenceRing(_In_ struct amdgpu_device* Adev, ULONG Ring)
-{
-    if (Ring == BC250_FENCE_RING_GFX) return &Adev->gfx.gfx_ring[0];

-   if (ws->bc250) {
+   if (ws->bc250 && surface_image) {
+      /* WSI present surface: the KMD's 32-byte LB7A surface block (the one
+       * its present path and the D3D user-mode driver share), not BC2A. The
+       * KMD sizes the allocation from Size, places it in VRAM and keeps it
+       * physically contiguous, which its present copy requires. Pitch is the
+       * linear layout RADV chose for the dedicated image; nothing overrides
+       * it afterwards (GFX10 refuses pitch overrides). */
+      const struct radeon_surf *surf = &surface_image->planes[0].surface;
+      struct bc250_linear_surface_blob {
+         uint32_t magic, version, width, height, pitch, format;
+         uint64_t size;
+      } surface;
+      _Static_assert(sizeof(surface) == 32, "LB7A v1 ABI");
+      uint32_t format;
+      switch (surface_image->vk.format) {
+      case VK_FORMAT_B8G8R8A8_UNORM:
+      case VK_FORMAT_B8G8R8A8_SRGB:
+         format = D3DDDIFMT_A8R8G8B8;
+         break;
+      case VK_FORMAT_R8G8B8A8_UNORM:
+      case VK_FORMAT_R8G8B8A8_SRGB:
+         format = D3DDDIFMT_A8B8G8R8;
+         break;
+      default:
+         format = 0;
+         break;
+      }
+      const uint64_t pitch = (uint64_t)surf->u.gfx9.surf_pitch * surf->bpe;
+      if (!surf->is_linear || format == 0 || surface_image->vk.extent.width == 0 ||
+          surface_image->vk.extent.height == 0 || surface_image->vk.extent.width > 8192 ||
+          surface_image->vk.extent.height > 8192 || (pitch & 15) ||
+          pitch < (uint64_t)surface_image->vk.extent.width * 4 ||
+          pitch > UINT32_MAX || phys_size < pitch * surface_image->vk.extent.height ||
+          phys_size > 0x10000000ull || !(initial_domain & RADEON_DOMAIN_VRAM)) {
+         fprintf(stderr, "wddm2: present surface %ux%u format %u pitch %" PRIu64 " linear %u size %" PRIu64

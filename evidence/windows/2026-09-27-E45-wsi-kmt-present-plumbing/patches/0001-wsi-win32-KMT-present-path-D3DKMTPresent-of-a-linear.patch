+/* wsi_device::blit for KMT chains. The common present flow signals the blit
+ * semaphore at N on the rendering queue, calls this, then submits a wait for
+ * the value left in timeline_values before signalling the per-image fences.
+ * The present (GPU wait N, D3DKMTPresent, GPU signal N + 1 on the driver's
+ * present context) is issued here so that the signal is queued before the
+ * submit that waits for it. A failed present is reported by
+ * wsi_win32_queue_present; the driver queues the signal in every case, so
+ * the flow completes and the image returns to the application. */
+VkResult
+wsi_win32_kmt_blit(struct wsi_swapchain *drv_chain, uint32_t image_index)
+{
+   struct wsi_win32_swapchain *chain = (struct wsi_win32_swapchain *)drv_chain;
+   struct wsi_win32_image *image = &chain->images[image_index];
+   struct wsi_device *wsi_device = chain->wsi->wsi;
+
+   if (!chain->kmt)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   image->kmt.t_enter = chain->present_log ? os_time_get_nano() : 0;
+   const uint64_t wait_value = chain->base.blit.timeline_values[image_index];
+   const uint64_t signal_value = ++chain->base.blit.timeline_values[image_index];
+   image->kmt.present_result =
+      wsi_device->win32.kmt_present(chain->base.device, image->base.memory, chain->wnd,
+                                    chain->extent, 0, NULL,
+                                    chain->base.blit.semaphores[image_index],
+                                    wait_value, signal_value);
+   image->kmt.t_blit = chain->present_log ? os_time_get_nano() : 0;
+   /* Only a lost device (no signal queued) stops the flow. */
+   return image->kmt.present_result == VK_ERROR_DEVICE_LOST ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+}

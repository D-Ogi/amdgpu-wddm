+                 surface_image->vk.extent.height, surface_image->vk.format, pitch, surf->is_linear,
+                 phys_size);
+         FREE(bo);
+         return VK_ERROR_FEATURE_NOT_PRESENT;
+      }
+      memset(&surface, 0, sizeof(surface));
+      surface.magic = 0x4137424c; /* "LB7A" */
+      surface.version = 1;
+      surface.width = surface_image->vk.extent.width;
+      surface.height = surface_image->vk.extent.height;
+      surface.pitch = (uint32_t)pitch;
+      surface.format = format;
+      surface.size = phys_size;
+      memcpy(alloc_pdata, &surface, sizeof(surface));
+      pdata_size = sizeof(surface);
+      bo->md.metadata_type = RADEON_METADATA_TYPE_KMW;
+      bo->md.kmw.pitch_bytes = (uint32_t)pitch;
+      bo->md.kmw.surf_size = surf->surf_size;

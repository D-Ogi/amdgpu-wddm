+         result = VK_ERROR_SURFACE_LOST_KHR;
+      else if ((uint32_t)(rect.right - rect.left) != chain->extent.width ||
+               (uint32_t)(rect.bottom - rect.top) != chain->extent.height)
+         result = VK_ERROR_OUT_OF_DATE_KHR;

+/* The present context: a non-UMD context of the device (no private driver
+ * data, node 0), the kind bc250kmd's DxgkDdiPresent accepts for a Blt. It
+ * carries only the present, its wait and its signal. Created on the first
+ * present, destroyed with the winsys. */
+static VkResult
+radv_wddm2_wsi_present_context(struct radv_wddm2_winsys *ws, uint32_t *context_h)
+{
+   VkResult result = VK_SUCCESS;
+
+   simple_mtx_lock(&ws->wsi.present_lock);
+   if (!ws->wsi.present_context_h) {
+      D3DKMT_CREATECONTEXTVIRTUAL create = {
+         .hDevice = ws->device_h,
+         .NodeOrdinal = 0,
+         .EngineAffinity = 1,
+         .ClientHint = D3DKMT_CLIENTHINT_VULKAN,
+      };
+      NTSTATUS status = BC250_WDDM_CALL(&ws->host, CreateContextVirtual, &create);
+      if (!NT_SUCCESS(status)) {
+         fprintf(stderr, "wddm2: present context creation failed 0x%X\n", status);
+         result = VK_ERROR_SURFACE_LOST_KHR;
+      } else {
+         ws->wsi.present_context_h = create.hContext;
+      }
+   }
+   *context_h = ws->wsi.present_context_h;
+   simple_mtx_unlock(&ws->wsi.present_lock);
+   return result;
+}
+
+/* wsi_device::win32.kmt_present: the OpenGL-ICD window present. Queue on the
+ * present context a GPU wait for the blit fence at wait_value, the present
+ * of the image's allocation, then a GPU signal at signal_value. dxgkrnl
+ * delivers the copy to the KMD's DxgkDdiPresent(Blt) with the destination it
+ * chose (redirection surface, primary or cross-adapter surface). */
+static VkResult
+radv_wddm2_wsi_kmt_present(VkDevice _device, VkDeviceMemory _memory, void *hwnd,
+                           VkExtent2D extent, uint32_t rect_count, const VkRect2D *rects,
+                           VkSemaphore _semaphore, uint64_t wait_value, uint64_t signal_value)
+{
+   VK_FROM_HANDLE(radv_device, device, _device);
+   VK_FROM_HANDLE(radv_device_memory, memory, _memory);
+   VK_FROM_HANDLE(vk_semaphore, semaphore, _semaphore);
+   struct radv_wddm2_winsys *ws = radv_wddm2_winsys(device->ws);
+   VkResult result = VK_SUCCESS;
+   NTSTATUS status;
+   uint32_t context_h;
+
+   if (!memory || !memory->bo || !semaphore)
+      return VK_ERROR_SURFACE_LOST_KHR;
+   struct vk_wddm2_monitored_fence *fence =
+      vk_sync_as_wddm2_monitored_fence(vk_semaphore_get_active_sync(semaphore));
+   if (!fence)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   struct radv_wddm2_bo *bo = radv_wddm2_bo(memory->bo);
+
+   result = radv_wddm2_wsi_present_context(ws, &context_h);
+   if (result != VK_SUCCESS)
+      return result;
+
+   uint32_t fence_h = fence->handle;
+   D3DKMT_WAITFORSYNCHRONIZATIONOBJECTFROMGPU wait = {
+      .hContext = context_h,
+      .ObjectCount = 1,
+      .ObjectHandleArray = &fence_h,
+      .MonitoredFenceValueArray = &wait_value,
+   };
+   status = BC250_WDDM_CALL(&ws->host, WaitForSynchronizationObjectFromGpu, &wait);
+   if (!NT_SUCCESS(status)) {
+      fprintf(stderr, "wddm2: present wait failed 0x%X\n", status);
+      /* Without the queued wait the signal below would run early; the
+       * chain is lost rather than the image presented out of order. */
+      return VK_ERROR_SURFACE_LOST_KHR;
+   }
+
+   RECT full = { 0, 0, (LONG)extent.width, (LONG)extent.height };
+   RECT sub_rects[16];
+   uint32_t sub_count = 0;
+   if (rect_count && rect_count <= ARRAY_SIZE(sub_rects)) {
+      for (uint32_t i = 0; i < rect_count; i++) {
+         sub_rects[i].left = rects[i].offset.x;
+         sub_rects[i].top = rects[i].offset.y;
+         sub_rects[i].right = rects[i].offset.x + (LONG)rects[i].extent.width;
+         sub_rects[i].bottom = rects[i].offset.y + (LONG)rects[i].extent.height;
+      }
+      sub_count = rect_count;
+   }
+
+   D3DKMT_PRESENT present = {
+      .hContext = context_h,
+      .hWindow = (HWND)hwnd,
+      .hSource = bo->base.handle,
+      .DstRect = full,
+      .SrcRect = full,
+      .SubRectCnt = sub_count,
+      .pSrcSubRects = sub_count ? sub_rects : NULL,
+      .Flags = {
+         .Blt = 1,
+         .DstRectValid = 1,
+         .SrcRectValid = 1,
+      },
+   };
+   status = BC250_WDDM_CALL(&ws->host, Present, &present);
+   if (!NT_SUCCESS(status)) {
+      static int reported;
+      if (reported < 8) {
+         reported++;
+         fprintf(stderr, "wddm2: D3DKMTPresent failed 0x%X (window %p, source 0x%x, %ux%u)\n",
+                 status, hwnd, bo->base.handle, extent.width, extent.height);
+      }
+      result = VK_ERROR_SURFACE_LOST_KHR;
+   } else if (ws->bc250_trace_submits) {
+      fprintf(stderr, "wddm2: D3DKMTPresent window %p source 0x%x %ux%u composition %u fence 0x%x %" PRIu64
+              " -> %" PRIu64 "\n", hwnd, bo->base.handle, extent.width, extent.height,
+              present.bOptimizeForComposition, fence_h, wait_value, signal_value);
+   }
+
+   /* Always queued: the rendering queue waits for signal_value. */
+   D3DKMT_SIGNALSYNCHRONIZATIONOBJECTFROMGPU signal = {
+      .hContext = context_h,
+      .ObjectCount = 1,
+      .ObjectHandleArray = &fence_h,
+      .MonitoredFenceValueArray = &signal_value,
+   };
+   status = BC250_WDDM_CALL(&ws->host, SignalSynchronizationObjectFromGpu, &signal);
+   if (!NT_SUCCESS(status)) {
+      fprintf(stderr, "wddm2: present signal failed 0x%X\n", status);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   return result;
+}

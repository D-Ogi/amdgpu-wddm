+static VkResult
+wsi_kmt_create_image_mem(const struct wsi_swapchain *chain,
+                         const struct wsi_image_info *info,
+                         struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
+
+   VkImageSubresource subres = {};
+   subres.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+   VkSubresourceLayout layout;
+   wsi->GetImageSubresourceLayout(chain->device, image->image, &subres, &layout);
+   assert(layout.offset == 0);
+
+   VkMemoryDedicatedAllocateInfo dedicated = {};
+   dedicated.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+   dedicated.image = image->image;
+
+   /* The winsys describes this allocation as a presentable linear surface. */
+   struct wsi_memory_allocate_info wsi_alloc = {};
+   wsi_alloc.sType = VK_STRUCTURE_TYPE_WSI_MEMORY_ALLOCATE_INFO_MESA;
+   wsi_alloc.pNext = &dedicated;
+   wsi_alloc.present_surface = true;
+
+   VkMemoryAllocateInfo mem_info = {};
+   mem_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+   mem_info.pNext = &wsi_alloc;
+   mem_info.allocationSize = reqs.size;
+   mem_info.memoryTypeIndex = wsi_select_device_memory_type(wsi, reqs.memoryTypeBits);
+
+   VkResult result = wsi->AllocateMemory(chain->device, &mem_info,
+                                         &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS)
+      return result;
+
+   image->num_planes = 1;
+   image->sizes[0] = reqs.size;
+   image->row_pitches[0] = layout.rowPitch;
+   image->offsets[0] = 0;
+   return VK_SUCCESS;

+   if (ws->bc250) {
+      /* BC250_WSI_CPU_PRESENT=1 keeps the CPU present path (diagnostic use).
+       * The hosted ICD keeps it too: host version 5 serves no Present. */
+      const char *cpu = getenv("BC250_WSI_CPU_PRESENT");

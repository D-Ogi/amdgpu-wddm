#version 450
/* Naive square matrix multiply, C = A*B, row major, one invocation per output element.
 * Entries are small integers, so every partial sum is exact in float32 and this shader, the
 * tiled one and the C reference must all agree to the bit. */
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer A {
	float v[];
} a;

layout(std430, binding = 1) readonly buffer B {
	float v[];
} b;

layout(std430, binding = 2) writeonly buffer C {
	float v[];
} c;

layout(push_constant) uniform Push {
	uint n;
} p;

void main()
{
	uint row = gl_GlobalInvocationID.y;
	uint col = gl_GlobalInvocationID.x;
	if (row >= p.n || col >= p.n)
		return;

	float sum = 0.0;
	for (uint k = 0; k < p.n; ++k)
		sum += a.v[row * p.n + k] * b.v[k * p.n + col];
	c.v[row * p.n + col] = sum;
}

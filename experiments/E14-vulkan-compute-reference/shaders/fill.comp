#version 450
/* Constant fill over p.n uint32. A grid-stride loop, so the same shader covers the whole buffer
 * whether it is dispatched with one workgroup or with sixteen: the output must be identical and
 * only the time may differ. Mirrors the 64 KiB memset dispatch of libdrm's amdgpu test. */
layout(local_size_x = 64) in;

layout(std430, binding = 0) writeonly buffer Out {
	uint v[];
} o;

layout(push_constant) uniform Push {
	uint n;
	uint value;
} p;

void main()
{
	uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
	for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride)
		o.v[i] = p.value;
}

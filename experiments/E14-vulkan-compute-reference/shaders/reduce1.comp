#version 450
/* Reduction pass 1: one partial sum per workgroup over a contiguous block of p.per_group
 * elements. Each invocation first folds its strided slice into a register, then the workgroup
 * folds the 64 registers through workgroup memory in a binary tree. uint32 addition wraps
 * modulo 2^32 and is associative, so this order and the straight loop of the C reference must
 * agree to the bit.
 *
 * barrier() sits at loop level, outside the `if`, because it must be reached by every invocation
 * of the workgroup. */
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer In {
	uint v[];
} a;

layout(std430, binding = 1) writeonly buffer Out {
	uint v[];
} o;

layout(push_constant) uniform Push {
	uint n;
	uint per_group;
} p;

shared uint s[64];

void main()
{
	uint g = gl_WorkGroupID.x;
	uint t = gl_LocalInvocationID.x;
	uint base = g * p.per_group;

	uint acc = 0u;
	for (uint i = t; i < p.per_group; i += gl_WorkGroupSize.x) {
		uint idx = base + i;
		if (idx < p.n)
			acc += a.v[idx];
	}
	s[t] = acc;
	barrier();

	for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
		if (t < stride)
			s[t] += s[t + stride];
		barrier();
	}

	if (t == 0u)
		o.v[g] = s[0];
}

+      D3DDDICB_FREEGPUVIRTUALADDRESS b = {};
+      b.BaseAddress=a->BaseAddress; b.Size=a->Size;
+      return HOST_CALL(FreeGpuVirtualAddress, &b);
+   }
+   case BC250_HOST_Evict: {
+      auto *a=(D3DKMT_EVICT *)argument;
+      D3DDDICB_EVICT b = {};

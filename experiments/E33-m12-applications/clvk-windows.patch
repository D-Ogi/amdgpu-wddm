diff --git a/src/host_clock.hpp b/src/host_clock.hpp
new file mode 100644
index 0000000..2e5805a
--- /dev/null
+++ b/src/host_clock.hpp
@@ -0,0 +1,34 @@
+// Windows host timestamps shared by calibrated Vulkan and OpenCL events.
+#pragma once
+#include <cstdint>
+#include <limits>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+inline uint64_t cvk_counter_to_ns(uint64_t ticks, uint64_t frequency) {
+    constexpr uint64_t billion = 1000000000;
+    const uint64_t seconds = ticks / frequency;
+    const uint64_t remainder = ticks % frequency;
+    // Split whole seconds to avoid overflow and preserve precision at long uptime.
+    const uint64_t fraction = remainder <= UINT64_MAX / billion
+        ? remainder * billion / frequency
+        : static_cast<uint64_t>(static_cast<long double>(remainder) * billion / frequency);
+    return seconds * billion + fraction;
+}
+#ifdef _WIN32
+inline uint64_t cvk_host_counter_frequency() {
+    static const uint64_t frequency = [] {
+        LARGE_INTEGER value;
+        QueryPerformanceFrequency(&value);
+        return static_cast<uint64_t>(value.QuadPart);
+    }();
+    return frequency;
+}
+inline uint64_t cvk_host_clock_ns() {
+    LARGE_INTEGER counter;
+    QueryPerformanceCounter(&counter);
+    return cvk_counter_to_ns(static_cast<uint64_t>(counter.QuadPart),
+                             cvk_host_counter_frequency());
+}
+#endif

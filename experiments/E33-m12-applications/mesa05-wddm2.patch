+/* Windows headers conflict with Wayland and XLib headers */
+#undef VK_USE_PLATFORM_WAYLAND_KHR
+#undef VK_USE_PLATFORM_XLIB_KHR
+#undef VK_USE_PLATFORM_XLIB_XRANDR_EXT
+

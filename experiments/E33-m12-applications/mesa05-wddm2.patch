diff --git a/src/amd/vulkan/winsys/common/radv_winsys_bo.h b/src/amd/vulkan/winsys/common/radv_winsys_bo.h
new file mode 100644
index 00000000000..66e5559f09e
--- /dev/null
+++ b/src/amd/vulkan/winsys/common/radv_winsys_bo.h
@@ -0,0 +1,306 @@

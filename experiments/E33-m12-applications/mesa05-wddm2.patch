+#define RADV_WDDM2_PRT_CONTROL_BIT    46
+#define RADV_WDDM2_PRT_CONTROL_MASK   (1ull << RADV_WDDM2_PRT_CONTROL_BIT)
+#define RADV_WDDM2_REPLAY_HEAP_START   (1ull << 45)

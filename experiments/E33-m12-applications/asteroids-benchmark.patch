+        auto desc = source->GetDesc();
+        const bool bgra = desc.Format == TEX_FORMAT_BGRA8_UNORM ||
+                          desc.Format == TEX_FORMAT_BGRA8_UNORM_SRGB;
+        if (!bgra && desc.Format != TEX_FORMAT_RGBA8_UNORM &&
+                     desc.Format != TEX_FORMAT_RGBA8_UNORM_SRGB)
+            throw std::runtime_error("Unsupported benchmark capture format");
+        desc.Name = "BC250 benchmark readback";
+        desc.Usage = USAGE_STAGING;
+        desc.BindFlags = BIND_NONE;
+        desc.CPUAccessFlags = CPU_ACCESS_READ;
+        desc.MiscFlags = MISC_TEXTURE_FLAG_NONE;
+        RefCntAutoPtr<ITexture> staging;
+        mDevice->CreateTexture(desc, nullptr, &staging);
+        if (!staging) throw std::runtime_error("Benchmark staging allocation failed");
+        mDeviceCtxt->SetRenderTargets(0, nullptr, nullptr, RESOURCE_STATE_TRANSITION_MODE_NONE);
+        CopyTextureAttribs copy{source, RESOURCE_STATE_TRANSITION_MODE_TRANSITION,
+                               staging, RESOURCE_STATE_TRANSITION_MODE_TRANSITION};
+        mDeviceCtxt->CopyTexture(copy);
+        mDeviceCtxt->WaitForIdle();
+        MappedTextureSubresource mapped;
+        mDeviceCtxt->MapTextureSubresource(staging, 0, 0, MAP_READ,
+                                         MAP_FLAG_DO_NOT_WAIT, nullptr, mapped);
+        if (!mapped.pData) throw std::runtime_error("Benchmark readback mapping failed");
+        std::ofstream image(settings.benchmarkCapture, std::ios::binary | std::ios::trunc);
+        image << "P6\n" << desc.Width << ' ' << desc.Height << "\n255\n";
+        std::vector<char> row(desc.Width * 3);
+        for (Uint32 y = 0; y < desc.Height; ++y) {
+            const auto* pixels = static_cast<const Uint8*>(mapped.pData) + y * mapped.Stride;
+            for (Uint32 x = 0; x < desc.Width; ++x) {
+                row[x * 3] = static_cast<char>(pixels[x * 4 + (bgra ? 2 : 0)]);
+                row[x * 3 + 1] = static_cast<char>(pixels[x * 4 + 1]);
+                row[x * 3 + 2] = static_cast<char>(pixels[x * 4 + (bgra ? 0 : 2)]);
+            }
+            image.write(row.data(), row.size());
+        }
+        mDeviceCtxt->UnmapTextureSubresource(staging, 0, 0);
+        image.flush();
+        if (!image) throw std::runtime_error("Benchmark image write failed");
+    }
+    BenchmarkStage("before-present");
     mSwapChain->Present(settings.vsync ? 1 : 0);
+    BenchmarkStage("after-present");

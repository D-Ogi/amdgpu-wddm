+
+void Asteroids::WriteBenchmarkGpuCsv(const char* path)
+{
+    if (mBenchmarkFrame != mBenchmarkQueries.size())
+        throw std::runtime_error("Incomplete GPU benchmark");
+    mDeviceCtxt->WaitForIdle();
+    std::ofstream output(path, std::ios::out | std::ios::trunc);
+    output << "frame,gpu_duration_ticks,frequency_hz,gpu_render_interval_ms\n";
+    output << std::fixed << std::setprecision(9);
+    for (unsigned frame = 0; frame < mBenchmarkQueries.size(); ++frame) {
+        QueryDataDuration data;
+        if (!mBenchmarkQueries[frame]->GetData(&data, sizeof(data)) || !data.Frequency || !data.Duration)
+            throw std::runtime_error("GPU duration unavailable or invalid");
+        output << frame + 1 << ',' << data.Duration << ',' << data.Frequency << ','
+               << 1000.0 * double(data.Duration) / double(data.Frequency) << '\n';
+    }
+    output.flush();
+    if (!output) throw std::runtime_error("GPU benchmark CSV write failed");
 }
 

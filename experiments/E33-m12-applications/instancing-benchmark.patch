diff --git a/C++/DXUT/Optional/BC250Benchmark.h b/C++/DXUT/Optional/BC250Benchmark.h
new file mode 100644
index 0000000..6344e9f
--- /dev/null
+++ b/C++/DXUT/Optional/BC250Benchmark.h
@@ -0,0 +1,50 @@
+// BC250 standalone benchmark instrumentation. SPDX-License-Identifier: MIT
+#pragma once
+#include <fstream>
+#include <iomanip>
+#include <cstdio>
+
+class BC250Benchmark {
+    std::ofstream csv;
+    LARGE_INTEGER frequency{};
+    unsigned frame = 0;
+    char capture[MAX_PATH]{};
+public:
+    bool enabled = false;
+    BC250Benchmark() {
+        char path[MAX_PATH]{};
+        enabled = GetEnvironmentVariableA("BC250_BENCHMARK_CSV", path, MAX_PATH) != 0;
+        if (!enabled) return;
+        csv.open(path, std::ios::out | std::ios::trunc);
+        if (!csv) ExitProcess(4);
+        csv << "frame,cpu_render_submit_ms\n" << std::fixed << std::setprecision(9);
+        QueryPerformanceFrequency(&frequency);
+        GetEnvironmentVariableA("BC250_BENCHMARK_CAPTURE", capture, MAX_PATH);
+    }
+    LARGE_INTEGER Begin() const {
+        LARGE_INTEGER tick{};
+        if (enabled) QueryPerformanceCounter(&tick);
+        return tick;
+    }
+    bool End(LARGE_INTEGER start) {
+        if (!enabled) return false;
+        LARGE_INTEGER end;
+        QueryPerformanceCounter(&end);
+        csv << ++frame << ',' << 1000.0 * double(end.QuadPart - start.QuadPart) /
+                                   frequency.QuadPart << '\n';
+        if (frame == 660) {
+            csv.flush();
+            if (!csv) ExitProcess(4);
+            return capture[0] != 0;
+        }
+        return false;
+    }
+    const char* CapturePath() const { return capture; }
+    void CheckCapture(HRESULT hr) const {
+        if (FAILED(hr)) {
+            fprintf(stderr, "BC250 capture failed: 0x%08lx\n", (unsigned long)hr);
+            ExitProcess(5);
+        }
+    }
+};
+static BC250Benchmark g_BC250Benchmark;

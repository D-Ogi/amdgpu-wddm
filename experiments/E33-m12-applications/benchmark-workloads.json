{
  "status": "frozen_before_measurements; runtime_validation_and_image_capture_pending",
  "resolution": [
    1080,
    720
  ],
  "shader_clock_mhz": 1000,
  "vid": 116,
  "warmup_runs": 1,
  "measured_repeats": 5,
  "asteroids": {
    "backends": [
      "-vk",
      "-d3d11",
      "-d3d12"
    ],
    "arguments": [
      "-window",
      "1080",
      "720",
      "-threads",
      "4",
      "-benchmark_frames",
      "660",
      "-benchmark_output",
      "frames.csv"
    ],
    "simulation_step_seconds": "1/60",
    "discard_initial_frames": 60,
    "measured_frames": 600,
    "csv_metric": "cpu_update_submit_present_ms",
    "metric_is_gpu_time": false,
    "image_capture": {
      "arguments": [
        "-benchmark_capture",
        "frame660.ppm"
      ],
      "format": "P6 RGB8; native sRGB encoded bytes; no alpha",
      "frame": 660,
      "separate_from_performance_run": true,
      "synchronization": "copy to staging; WaitForIdle; map; preserve row pitch",
      "runtime_validation": "pending"
    },
    "gpu_timing": {
      "file": "frames.csv.gpu.csv",
      "metric": "gpu_render_interval_ms",
      "raw_fields": [
        "gpu_duration_ticks",
        "frequency_hz"
      ],
      "scope": "GPU timeline interval around render commands, before readback and Present; may include idle gaps",
      "queries": "allocated before loop; results drained after last CPU timing",
      "runtime_validation": "pending"
    }
  },
  "instancing": {
    "api_versions": [
      9,
      10
    ],
    "arguments": [
      "-windowed",
      "-width:1080",
      "-height:720",
      "-forcevsync:0",
      "-constantframetime:0.016666666666666667",
      "-quitafterframe:660",
      "-forcehal",
      "-noerrormsgboxes",
      "-nostats"
    ],
    "api_selection": "-forceapi:9 or -forceapi:10",
    "instrumentation": {
      "environment": {
        "BC250_BENCHMARK_CSV": "frames.csv",
        "BC250_BENCHMARK_CAPTURE": "frame660.png (optional, correctness run only)"
      },
      "metric": "cpu_render_submit_ms; excludes Present and GPU completion",
      "capture_frame": 660,
      "discard_initial_frames": 60,
      "measured_frames": 600,
      "statistics_ui": "hidden in benchmark mode",
      "runtime_validation": "pending"
    }
  },
  "shader_cache": {
    "policy": "One fresh directory per OS/API/artifact set for warm-up; reuse for all five measured repeats. Capture uses a separate directory.",
    "environment": [
      "MESA_SHADER_CACHE_DIR",
      "DXVK_SHADER_CACHE_PATH",
      "VKD3D_SHADER_CACHE_PATH"
    ],
    "identity": "Kind, package manifest SHA256 and ICD SHA256 must match on reuse. Never share caches across Windows/Linux.",
    "runtime_validation": "pending"
  }

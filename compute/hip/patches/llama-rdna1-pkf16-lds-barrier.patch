From: D-Ogi <6542335+D-Ogi@users.noreply.github.com>
Date: Fri, 30 Oct 2026 20:58:57 +0100
Subject: [PATCH] ggml-cuda: PKF16 stages synchronise LDS only

The threads of a block share data only through LDS, so the two barriers
of each K step need an LDS fence only. __syncthreads() also fenced global
memory at workgroup scope, which in WGP mode put a buffer_gl0_inv after
each barrier and discarded the L0 lines of the A rows. On the BC-250
(40 CU, 1500 MHz) Qwen3-8B Q8_0 pp512 goes from 235.3 to 252.1 t/s. The
kernel stays at 125 VGPRs.
---
 ggml/src/ggml-cuda/mmf16-rdna1.cu | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmf16-rdna1.cu b/ggml/src/ggml-cuda/mmf16-rdna1.cu
index 1db2bc50..554f8eec 100644
--- a/ggml/src/ggml-cuda/mmf16-rdna1.cu
+++ b/ggml/src/ggml-cuda/mmf16-rdna1.cu
@@ -206,6 +206,20 @@ static __device__ __forceinline__ void mmf16_load_b(
     }
 }
 
+// The threads of a block share data only through LDS: A and B are read-only and every element of C has
+// one writer. So the barrier between the stages has to order LDS accesses only. __syncthreads() also
+// orders global memory at workgroup scope, and in WGP mode that costs a buffer_gl0_inv after each
+// barrier, two per K step: it discards the L0 lines of the A rows that the next K steps read again.
+static __device__ __forceinline__ void mmf16_sync_lds() {
+#if defined(__HIP_DEVICE_COMPILE__)
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+#else
+    __syncthreads();
+#endif
+}
+
 // The tile is a template parameter because the shipped 128x128 leaves only four column tiles at a
 // 512-token batch, which is the batch the benchmarks use; see logs/rdna1-pkf16-tile-2026-09-20.
 // mmf16_load_a puts one thread on each row of the A tile, so the block must have exactly BM threads,
@@ -264,7 +278,7 @@ static __global__ void __launch_bounds__(BM) mmf16_rdna1_gemm(
                 mmf16_load_a<type, BM>(A, As[0], row0, k0, M, row_size, tid);
                 mmf16_load_b<BM, BN, mmid>(B, Bs[0], col0, cend, k0, sb, ids_src1, tid);
             }
-            __syncthreads();
+            mmf16_sync_lds();
 
             if (dbuf && k0 + MMF16_BK < K) {            // fetch the next tile over this stage's arithmetic
                 mmf16_load_a<type, BM>(A, As[nxt], row0, k0 + MMF16_BK, M, row_size, tid);
@@ -297,7 +311,7 @@ static __global__ void __launch_bounds__(BM) mmf16_rdna1_gemm(
                         acc[j][i] = make_half2(0.0f, 0.0f);
                     }
             }
-            __syncthreads();
+            mmf16_sync_lds();
         }
 
 #pragma unroll

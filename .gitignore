# Python
__pycache__/
*.pyc
.venv/

# Generated shader bytecode headers (fxc /Fh output, reproducible from the build script)
/driver/umd/mft-h264/shaders/gen/
/driver/umd/mft-h264/tests/gen/

# Build output (WDK / MSBuild)
/driver/**/x64/
/driver/**/Debug/
/driver/**/Release/
*.sys
*.pdb
*.obj
*.cat
*.cer
*.pfx

# Never commit: AMD firmware blobs, crash dumps, secrets, local scratch
*.dmp
*.bin
# Generated setting catalog, not firmware. tools/state/generate.py owns it.
!/driver/state/amdgpu-state.bin
*.bin.zst
/secrets/
wpa_supplicant.conf
*_ed25519
*_ed25519.pub
authorized_keys
/scratch/
# The default work folder of the installer host tests run from the repo (tools\release\test-*.ps1 without -WorkRoot)
/tools/test-tmp/

# Hardware captures: tables are fine, the VBIOS never is (VFCT embeds it)
!evidence/**/*.bin
*.rom
VFCT*

# Evidence logs are evidence (a global "*.log" exclude must not hide them)
!/evidence/**/*.log

			union large_integer dcc_const_color;
		} grph;

		struct {
			PHYSICAL_ADDRESS_LOC addr;
		} lut3d;

		/*stereo*/
		struct {
			PHYSICAL_ADDRESS_LOC left_addr;
			PHYSICAL_ADDRESS_LOC left_meta_addr;
			union large_integer left_dcc_const_color;

			PHYSICAL_ADDRESS_LOC right_addr;

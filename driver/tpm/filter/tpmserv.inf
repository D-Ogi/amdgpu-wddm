; SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
; The skeleton TPM servicer: an extension INF that adds a lower filter below the inbox tpm.sys.
; An extension INF never becomes the function driver, so tpm.sys stays in charge of ACPI\MSFT0101 and the filter
; only sees the requests below it. That also avoids the driver-rank loss against the signed inbox tpm.inf.

[Version]
Signature        = "$WINDOWS NT$"
Class            = Extension
ClassGuid        = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider         = %ProviderString%
CatalogFile      = tpmserv.cat
PnpLockdown      = 1
DriverVer        = 11/13/2026,1.0.0.0
ExtensionId      = {EFA23211-8F26-484A-B7BA-EC53027EBC4B}
ExtensionDriverVer = 11/13/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 13

[Manufacturer]
%ManufacturerString% = Bc250,NT$ARCH$

[Bc250.NT$ARCH$]
%DeviceString% = Tpmserv_Install, ACPI\MSFT0101

[Tpmserv_Install]
AddService = tpmserv, , Tpmserv_Service

[Tpmserv_Install.HW]
AddReg = Tpmserv_Filter_AddReg

; The filter is written into the device key, not the service key, and flag 0x00010008 appends to a REG_MULTI_SZ.
[Tpmserv_Filter_AddReg]
HKR,,"LowerFilters",0x00010008,"tpmserv"

[Tpmserv_Service]
DisplayName   = %ServiceString%
ServiceType   = %SERVICE_KERNEL_DRIVER%
StartType     = %SERVICE_BOOT_START%
ErrorControl  = %SERVICE_ERROR_NORMAL%
ServiceBinary = %13%\tpmserv.sys

[Strings]
ProviderString     = "BC-250 project"
ManufacturerString = "BC-250 project"
DeviceString       = "BC-250 TPM servicer filter"
ServiceString      = "BC-250 TPM servicer filter"
SERVICE_KERNEL_DRIVER = 0x00000001
SERVICE_BOOT_START    = 0x00000000
SERVICE_ERROR_NORMAL  = 0x00000001

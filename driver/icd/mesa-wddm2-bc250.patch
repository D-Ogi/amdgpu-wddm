+static uint32_t
+bc250_rd32(const uint8_t *p, uint32_t off)
+{
+   uint32_t v;
+   memcpy(&v, p + off, sizeof(v));
+   return v;
+}
+
+static uint64_t
+bc250_rd64(const uint8_t *p, uint32_t off)
+{
+   uint64_t v;
+   memcpy(&v, p + off, sizeof(v));
+   return v;

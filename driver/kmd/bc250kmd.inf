; bc250kmd: full WDDM miniport for the ASRock BC-250 GPU.
; Test-signed lab driver. Matches exactly one device; everything else keeps its own driver.

[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
CatalogFile = bc250kmd.cat
DriverVer   = 10/06/2026,0.7.213.1
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
;@UMD Bc250_UmdFiles = 11

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
bc250kmd.sys = 1
;@UMD bc250umd.dll = 1

[Manufacturer]
%Provider% = Models,NTamd64

[Models.NTamd64]
%DeviceName% = Bc250_Install, PCI\VEN_1002&DEV_13FE

[Bc250_Install]
FeatureScore = F8
CopyFiles    = Bc250_Files                      ;@PLAIN-ONLY
;@UMD CopyFiles    = Bc250_Files, Bc250_UmdFiles
;@UMD AddReg       = Bc250_UserModeDriver

[Bc250_Files]
bc250kmd.sys

; ---------------------------------------------------------------------------------------------------------------
; M7 stage A, second run only. Commented out on purpose, and NOT by hand: the markers below are the contract
; between this file and driver\kmd\build.ps1.
;
;   ;@UMD <line>        the line is part of the second run's package. build.ps1 -UmdStub uncomments it.
;   <line> ;@PLAIN-ONLY the line is part of the first run's package. build.ps1 -UmdStub comments it out.
;
; So there is one INF in the repository and two packages come out of it, and the diff between the packages is
; exactly this block rather than whatever somebody remembered to edit. build.ps1 throws if it finds no markers.
;
; Stage A is run twice, and the difference between the two runs is exactly this block (driver\kmd\README.md):
;
;   first run   no marked line is enabled. The adapter has no UserModeDriverName at all, so Direct3D cannot even
;               load a user-mode driver for it. This is the cheaper failure and is measured first.
;   second run  the marked lines enabled and bc250umd.dll (driver\umd-stub) in the package. The DLL loads and
;               every OpenAdapter entry point returns E_NOTIMPL. A runtime that gets that far has done more work
;               than one that found no driver name, and DWM may well treat the two differently.
;
; The three entries of the REG_MULTI_SZ are D3D9, D3D10 and D3D11 in that order; the same stub answers all three.
; 0x00010000 is REG_MULTI_SZ. Research section 2.1 quotes a Learn page that calls this value a REG_SZ; that page
; is the OpenGL ICD one and predates WDDM. Every shipping WDDM display INF writes a REG_MULTI_SZ here, so that is
; what is prepared - but if the second run shows the DLL is never loaded, a single REG_SZ (0x00000000) naming the
; same file is the first thing to try, and copying to the driver store (dirid 13) instead of System32 is the
; second, before concluding anything about the runtime.
;
; UserModeDriverNameWow, the 32-bit list, is deliberately NOT written. We build only a 64-bit stub, and a Wow
; value naming bc250umd.dll would point a 32-bit process at a file that is not in SysWOW64 - which makes "the
; runtime never asked for a 32-bit driver" and "the runtime asked and the load failed" the same observation, and
; telling those two apart is the entire purpose of the second run. A missing value is the honest statement that
; there is no 32-bit driver. (The nearby reference INF ref\keshas-driver__WARN-AGENTS-md-is-not-facts\inf\amdbc250_dream.inf line 114 points
; its Wow value at its 64-bit DLL; that is the mistake being avoided here, not a precedent.) If a 32-bit consumer
; ever has to be measured: build the stub a second time for x86 - which first needs the x86 SDK libraries, not
; currently unpacked under toolchain\nuget - copy it into SysWOW64, whose dirid is 16425 and not 10, and add the
; Wow line then.
;
;@UMD [Bc250_UmdFiles]
;@UMD bc250umd.dll
;@UMD
;@UMD [Bc250_UserModeDriver]
;@UMD HKR,, UserModeDriverName, 0x00010000, bc250umd.dll, bc250umd.dll, bc250umd.dll
; ---------------------------------------------------------------------------------------------------------------

; Message-signalled interrupts (milestone M6). The function has MSI (1 of 4 messages) and MSI-X (3) capabilities
; (evidence/linux/2026-09-21-E01-recon/lspci-gpu-vvv.txt); amdgpu used them on this unit. Without this section
; Windows assigns the line interrupt. The driver enables no interrupt source unless the EnableIh gate is open.
[Bc250_Install.HW]
AddReg = Bc250_Msi

[Bc250_Msi]
HKR, "Interrupt Management", , 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", , 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 1

[Bc250_Install.Services]
AddService = bc250kmd, 0x00000002, Bc250_Service

[Bc250_Service]
DisplayName   = %ServiceName%
ServiceType   = 1                   ; SERVICE_KERNEL_DRIVER
StartType     = 3                   ; SERVICE_DEMAND_START
ErrorControl  = 0                   ; SERVICE_ERROR_IGNORE: a failed start must never stop the boot
LoadOrderGroup = Video
ServiceBinary = %13%\bc250kmd.sys
AddReg        = Bc250_Parameters

[Bc250_Parameters]
; Boot-loop guard (guard.c). Installing the package grants a fresh start budget.
HKR, Parameters, UnconfirmedStarts, 0x00010001, 0
; Register access gates (mmio.c, ADR 0007). Every install closes them; an experiment opens them on purpose.
HKR, Parameters, EnableMmio,        0x00010001, 0
HKR, Parameters, EnableMmioWrite,   0x00010001, 0
HKR, Parameters, EnableVram,        0x00010001, 0
HKR, Parameters, EnableVramWrite,   0x00010001, 0
HKR, Parameters, EnableGart,        0x00010001, 0
HKR, Parameters, EnablePsp,         0x00010001, 0
HKR, Parameters, EnableGfx,         0x00010001, 0
HKR, Parameters, EnableIh,          0x00010001, 0
; The gated DCN flip (dcn.c, 0.7.20, ADR 0011 point 3 step 2). Needs EnableMmio; the fill needs EnableVramWrite too.
HKR, Parameters, EnableDcnWrite,    0x00010001, 0
; SetVidPnSourceAddress's own hardware flip plus the VUPDATE_NO_LOCK interrupt (dcn.c/wddm.c, 0.7.24, E22 step 3,
; ADR 0011 point 3 step 3). Needs EnableDcnWrite; meaningful only with EnableFullWddm open too. Closed by every
; install, like every gate above.
HKR, Parameters, EnableVidPnFlip,   0x00010001, 0
; The DDI table gate (entry.c, ADR 0008). 0 = DxgkInitializeDisplayOnlyDriver, the driver that runs the display
; today. 1 = DxgkInitialize with the full WDDM table of wddm.c. Closed by every install, like every gate above.
HKR, Parameters, EnableFullWddm,    0x00010001, 0
HKR, Parameters, EnableGpuVa,       0x00010001, 0
HKR, Parameters, EnableGpuSubmit,   0x00010001, 0
; ADR 0008 stage D (docs/design/paging-node.md): node 1, DXGK_ENGINE_TYPE_COPY on SDMA0, the paging node. Needs
; EnableGpuSubmit's own preconditions (EnableGfx, EnableIh); closed by every install, like every gate above.
HKR, Parameters, EnablePagingNode,  0x00010001, 0
HKR, Parameters, EnablePresentBlit, 0x00010001, 0
; Test-only hang bugcheck (hang.c, docs/design/hang-detector.md). 1 arms it at the next device start; it bugchecks
; the machine on purpose when no ordinary thread has run for HangBugcheckSeconds (5..60, default 10, left unset
; here). Closed by every install, like every gate above.
HKR, Parameters, EnableHangBugcheck, 0x00010001, 0
; The log ring into a file under C:\BC250\kmdlog at every device stop (guard.c GuardLogKeep). A synchronous file
; write in a PnP stop, so disabled by default. Preserve an explicitly enabled capture across
; an upgrade: AddReg may run before the old driver stops. DWORD | NOCLOBBER affects only logging.
HKR, Parameters, KeepLog,           0x00010003, 0
; ---- finished features: on by every install, each with one switch to bisect a regression -----------------------
; The three values below are not gates in the sense of the block above. Each one carries a feature that is
; written, reviewed and host-tested, and the release-train rule is that such a feature rides the driver on, with
; one switch an operator closes to get the previous behaviour back (owner, 2026-10-05). Writing 0 into any of
; them gives the behaviour of 0.7.208.1 for that one feature and nothing else.
;
; The board's own hardware monitor, read only (hwmon.c, docs/design/fan.md): the Nuvoton NCT6686D Super I/O that
; turns the case fan from the BIOS "Fan Setting" curve. 1 starts the reader; 0 means no x86 port access happens
; at all. The reader never writes a configuration, control, limit or duty register, so the fan stays in the
; chip's own automatic mode whatever this value is, and a window that does not answer like this chip is refused
; before any reading is believed. The EC window has no arbiter, so a third-party monitor driving the same ports
; can corrupt our reads: every sample is checked for plausibility, and a measured session needs the preflight
; check of the design document. HwmonBasePort 0 means the built-in 0x0A20, measured on unit A; the only other
; values the driver admits are 0x0A00 and 0x0A10, the two other windows the DSDT reports on this board. Anything
; else is refused before a port is touched, because this reader writes three latch bytes to read one register,
; and numbers such as 0x0CF8 (the PCI configuration address port) or 0x0CD0 (the FCH power-management index pair)
; would take those writes. HwmonExpectId and HwmonDutyProven are absent on purpose: the first pins the chip's
; customer ID once an operator has read it, the second says a lab trial proved the duty read-back.
HKR, Parameters, EnableHwmon,       0x00010001, 1
HKR, Parameters, HwmonBasePort,     0x00010001, 0
; The DirectFlip handshake, kernel half (wddm.c, docs/design/direct-flip-handshake.md, M15.14). 1 lets this start
; tell the compositor's user-mode driver, in the scan-out caps trailer, that it will admit a client scan-out flip
; and at what geometry. The driver ANDs it with every start-latched fact the flip path needs, so an open switch
; on a start that cannot flip still publishes nothing. 0 makes the trailer absent, which is 0.7.208.1 byte for
; byte at every buffer size.
HKR, Parameters, EnableDirectFlipHandshake, 0x00010001, 1
; The completion report pairs its own DPC-level notification (wddm.c, driver/kmd/notify_pairing.h, C50). 1 calls
; DxgkCbNotifyDpc at the end of the report pass, which is what the DDI text asks for, and the otherwise empty
; dxgkrnl DPC is not asked for at all: one DPC per completion fewer, measured at 12 to 20 us each. 0 is
; 0.7.208.1 exactly, where the notification arrives with the next dxgkrnl DPC.
HKR, Parameters, NotifyDpcInReport,  0x00010001, 1
; DisplayPort audio, steps 0 and 1 (dpaudio.c, M819): at every start and resume, the Azalia endpoint of the one DP
; stream the firmware left running is made present to the inbox HD Audio driver (pin configuration, one LPCM
; descriptor of 2 channels at 32/44.1/48 kHz and 16 bit, AUDIO_ENABLED). The start checks the codec ID, the audio
; strap, the stream encoder, the DP SST back end and the endpoint's pin configuration first, and writes nothing
; unless all of them hold; it needs BAR5 (EnableMmio). No DIG, DP, OTG or DTO register is written: no sound flows
; until step 2. EnableDpAudio 0 means no audio register is read or written at all, the behaviour before this
; feature; EnableDpAudioEndpoint 0 does the same for step 1 alone.
HKR, Parameters, EnableDpAudio,      0x00010001, 1
HKR, Parameters, EnableDpAudioEndpoint, 0x00010001, 1

[Strings]
Provider    = "amdgpu-wddm"
DiskName    = "bc250kmd installation media"
DeviceName  = "BC-250 GPU (amdgpu-wddm)"
ServiceName = "amdgpu-wddm kernel-mode driver"

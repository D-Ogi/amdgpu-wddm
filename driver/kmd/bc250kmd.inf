; bc250kmd: full WDDM miniport for the ASRock BC-250 GPU.
; Test-signed lab driver. Matches exactly one device; everything else keeps its own driver.

[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
CatalogFile = bc250kmd.cat
DriverVer   = 10/07/2026,0.7.216.19
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
;@UMD Bc250_UmdFiles = 11

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
bc250kmd.sys = 1
;@UMD bc250umd.dll = 1

[Manufacturer]
%Provider% = Models,NTamd64

[Models.NTamd64]
%DeviceName% = Bc250_Install, PCI\VEN_1002&DEV_13FE

[Bc250_Install]
FeatureScore = F8
CopyFiles    = Bc250_Files                      ;@PLAIN-ONLY
;@UMD CopyFiles    = Bc250_Files, Bc250_UmdFiles
;@UMD AddReg       = Bc250_UserModeDriver

[Bc250_Files]
bc250kmd.sys

; ---------------------------------------------------------------------------------------------------------------
; M7 stage A, second run only. Commented out on purpose, and NOT by hand: the markers below are the contract
; between this file and driver\kmd\build.ps1.
;
;   ;@UMD <line>        the line is part of the second run's package. build.ps1 -UmdStub uncomments it.
;   <line> ;@PLAIN-ONLY the line is part of the first run's package. build.ps1 -UmdStub comments it out.
;
; So there is one INF in the repository and two packages come out of it, and the diff between the packages is
; exactly this block rather than whatever somebody remembered to edit. build.ps1 throws if it finds no markers.
;
; Stage A is run twice, and the difference between the two runs is exactly this block (driver\kmd\README.md):
;
;   first run   no marked line is enabled. The adapter has no UserModeDriverName at all, so Direct3D cannot even
;               load a user-mode driver for it. This is the cheaper failure and is measured first.
;   second run  the marked lines enabled and bc250umd.dll (driver\umd-stub) in the package. The DLL loads and
;               every OpenAdapter entry point returns E_NOTIMPL. A runtime that gets that far has done more work
;               than one that found no driver name, and DWM may well treat the two differently.
;
; The three entries of the REG_MULTI_SZ are D3D9, D3D10 and D3D11 in that order; the same stub answers all three.
; 0x00010000 is REG_MULTI_SZ. Research section 2.1 quotes a Learn page that calls this value a REG_SZ; that page
; is the OpenGL ICD one and predates WDDM. Every shipping WDDM display INF writes a REG_MULTI_SZ here, so that is
; what is prepared - but if the second run shows the DLL is never loaded, a single REG_SZ (0x00000000) naming the
; same file is the first thing to try, and copying to the driver store (dirid 13) instead of System32 is the
; second, before concluding anything about the runtime.
;
; UserModeDriverNameWow, the 32-bit list, is deliberately NOT written. We build only a 64-bit stub, and a Wow
; value naming bc250umd.dll would point a 32-bit process at a file that is not in SysWOW64 - which makes "the
; runtime never asked for a 32-bit driver" and "the runtime asked and the load failed" the same observation, and
; telling those two apart is the entire purpose of the second run. A missing value is the honest statement that
; there is no 32-bit driver. (The nearby reference INF ref\keshas-driver__WARN-AGENTS-md-is-not-facts\inf\amdbc250_dream.inf line 114 points
; its Wow value at its 64-bit DLL; that is the mistake being avoided here, not a precedent.) If a 32-bit consumer
; ever has to be measured: build the stub a second time for x86 - which first needs the x86 SDK libraries, not
; currently unpacked under toolchain\nuget - copy it into SysWOW64, whose dirid is 16425 and not 10, and add the
; Wow line then.
;
;@UMD [Bc250_UmdFiles]
;@UMD bc250umd.dll
;@UMD
;@UMD [Bc250_UserModeDriver]
;@UMD HKR,, UserModeDriverName, 0x00010000, bc250umd.dll, bc250umd.dll, bc250umd.dll
; ---------------------------------------------------------------------------------------------------------------

; Message-signalled interrupts (milestone M6). The function has MSI (1 of 4 messages) and MSI-X (3) capabilities
; (evidence/linux/2026-09-21-E01-recon/lspci-gpu-vvv.txt); amdgpu used them on this unit. Without this section
; Windows assigns the line interrupt. The driver enables no interrupt source unless the EnableIh gate is open.
[Bc250_Install.HW]
AddReg = Bc250_Msi

[Bc250_Msi]
HKR, "Interrupt Management", , 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", , 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 1

[Bc250_Install.Services]
AddService = bc250kmd, 0x00000002, Bc250_Service

[Bc250_Service]
DisplayName   = %ServiceName%
ServiceType   = 1                   ; SERVICE_KERNEL_DRIVER
StartType     = 3                   ; SERVICE_DEMAND_START
ErrorControl  = 0                   ; SERVICE_ERROR_IGNORE: a failed start must never stop the boot
LoadOrderGroup = Video
ServiceBinary = %13%\bc250kmd.sys
AddReg        = Bc250_Parameters

[Bc250_Parameters]
; The driver settings this package writes. Every value here is the release default of
; tools\release\installer\registry-defaults.json, and the build gate tools\quality\inf_gates.py fails when the two
; drift apart, so the INF and the installer cannot disagree about what a gate's released value is.
;
; The flags are 0x00010003 = FLG_ADDREG_TYPE_DWORD | FLG_ADDREG_NOCLOBBER, except where a line below says otherwise.
; NOCLOBBER means the value is written when it is absent and left alone when it is there: a fresh install gets the
; released configuration, and an install over an existing one keeps what the installer, the control application or an
; experiment set. Up to 0.7.216.3 these were plain DWORD writes of 0 (BD-091), so every install this installer did not
; drive - Windows Update, Device Manager, pnputil by hand - closed each gate named here while EnableNativeSmu, which
; the INF did not name at all, stayed 1. The next start then asked for the SMU owner with no register mapping and
; failed with Code 43 (StageHistory ... 34 91). Two values keep the old unconditional write on purpose, and each says
; why at its line.
;
; Boot-loop guard (guard.c). No NOCLOBBER: installing the package grants a fresh start budget, which is the point.
HKR, Parameters, UnconfirmedStarts, 0x00010001, 0
; Register access gates (mmio.c, ADR 0007). A gate an experiment closes stays closed over a reinstall.
HKR, Parameters, EnableMmio,        0x00010003, 1
; EnableMmioWrite is not in the release table: the released configuration leaves it as it is, and a computer that has
; never had this driver gets the closed value. The gate's own table names it (inf_gates.py, NOT_IN_TABLE).
HKR, Parameters, EnableMmioWrite,   0x00010003, 0
HKR, Parameters, EnableVram,        0x00010003, 1
HKR, Parameters, EnableVramWrite,   0x00010003, 1
HKR, Parameters, EnableGart,        0x00010003, 1
HKR, Parameters, EnablePsp,         0x00010003, 1
HKR, Parameters, EnableGfx,         0x00010003, 1
HKR, Parameters, EnableIh,          0x00010003, 1
; The single native SMU owner (smu.c, pnp.c). It needs EnableMmio: without the BAR mapping there is no mailbox, and
; until 0.7.216.10 a start with this value 1 and EnableMmio 0 failed the whole device start instead of saying so
; (BD-091). The driver now logs the refusal and starts without the owner. Never re-enable a legacy direct SMU writer
; while this owner is active.
HKR, Parameters, EnableNativeSmu,   0x00010003, 1
; The gated DCN flip (dcn.c, 0.7.20, ADR 0011 point 3 step 2). Needs EnableMmio; the fill needs EnableVramWrite too.
HKR, Parameters, EnableDcnWrite,    0x00010003, 1
; SetVidPnSourceAddress's own hardware flip plus the VUPDATE_NO_LOCK interrupt (dcn.c/wddm.c, 0.7.24, E22 step 3,
; ADR 0011 point 3 step 3). Needs EnableDcnWrite; meaningful only with EnableFullWddm open too.
HKR, Parameters, EnableVidPnFlip,   0x00010003, 1
; The DDI table gate (entry.c, ADR 0008). 0 = DxgkInitializeDisplayOnlyDriver. 2 = DxgkInitialize with the full WDDM
; table of wddm.c, which is what the release runs.
HKR, Parameters, EnableFullWddm,    0x00010003, 2
HKR, Parameters, EnableGpuVa,       0x00010003, 1
HKR, Parameters, EnableGpuSubmit,   0x00010003, 1
; ADR 0008 stage D (docs/design/paging-node.md): node 1, DXGK_ENGINE_TYPE_COPY on SDMA0, the paging node. Needs
; EnableGpuSubmit's own preconditions (EnableGfx, EnableIh).
HKR, Parameters, EnablePagingNode,  0x00010003, 1
HKR, Parameters, EnablePresentBlit, 0x00010003, 1
; Test-only hang bugcheck (hang.c, docs/design/hang-detector.md). 1 arms it at the next device start; it bugchecks the
; machine on purpose when no ordinary thread has run for HangBugcheckSeconds (5..60, default 10, left unset here). No
; NOCLOBBER on purpose and not in the release table: installing a package disarms a test bugcheck somebody left armed.
HKR, Parameters, EnableHangBugcheck, 0x00010001, 0
; The log ring into a file under C:\BC250\kmdlog at every device start and stop (guard.c GuardLogKeep). A synchronous
; file write in a PnP stop, so disabled by default. An explicitly enabled capture survives an upgrade, as it has since
; 0.7.35: AddReg may run before the old driver stops.
HKR, Parameters, KeepLog,           0x00010003, 0
; ---- finished features: on by every install, each with one switch to bisect a regression -----------------------
; The values below are not gates in the sense of the block above. Each one carries a feature that is
; written, reviewed and host-tested, and the release-train rule is that such a feature rides the driver on, with
; one switch an operator closes to get the previous behaviour back (owner, 2026-10-05). Writing 0 into any of
; them gives the behaviour of 0.7.208.1 for that one feature and nothing else.
;
; The board's own hardware monitor, read only (hwmon.c, docs/design/fan.md): the Nuvoton NCT6686D Super I/O that
; turns the case fan from the BIOS "Fan Setting" curve. 1 starts the reader; 0 means no x86 port access happens
; at all. The reader never writes a configuration, control, limit or duty register (the fan control below is the
; one writer, and it needs this reader online), and a window that does not answer like this chip is refused
; before any reading is believed. The EC window has no arbiter, so a third-party monitor driving the same ports
; can corrupt our reads: every sample is checked for plausibility, and a measured session needs the preflight
; check of the design document. HwmonBasePort 0 means the built-in 0x0A20, measured on unit A; the only other
; values the driver admits are 0x0A00 and 0x0A10, the two other windows the DSDT reports on this board. Anything
; else is refused before a port is touched, because this reader writes three latch bytes to read one register,
; and numbers such as 0x0CF8 (the PCI configuration address port) or 0x0CD0 (the FCH power-management index pair)
; would take those writes. HwmonBasePort is not in the release table either (inf_gates.py NOT_IN_TABLE): 0 is the
; built-in default, and an operator who pinned another window keeps it over a reinstall. HwmonExpectId and
; HwmonDutyProven are absent on purpose: the first pins the chip's customer ID once an operator has read it, the
; second says a lab trial proved the duty read-back.
HKR, Parameters, EnableHwmon,       0x00010003, 1
HKR, Parameters, HwmonBasePort,     0x00010003, 0
; The case fan control (fan.c, docs/design/fan.md Part B). 1 lets the driver take fan 1 from the BIOS curve while
; it runs: it drives the fan on its own curve (at least as fast as the BIOS Standard Mode, 100 % from 80 C) and
; gives the fan back to the chip's automatic mode on every exit path - stop, remove, out of D0, unload, a stalled
; control step, a bugcheck. The BIOS "Fan Setting" is never changed (owner, 2026-10-06). It needs the reader above
; online and the chip identified as unit A's (or pinned with HwmonExpectId); otherwise it writes nothing. 0 means
; the driver never writes the chip, and the fan stays in the chip's own automatic mode whatever else is set. FanMode,
; FanProfile and the FanCurve values are the user's stored choice and are absent on purpose: the driver writes them
; when the user picks a fan setting in the control application.
HKR, Parameters, EnableFanControl,  0x00010003, 1
; The CPU tuning surface (cpu.c, docs/design/tuner.md). 1 opens it: the driver reads the CPU rail through the
; firmware's queue 3 at start, and the control application's processor cards may then run a change as a trial that
; reverts by itself. Nothing is changed at start: a setter runs only on an administrator's request, after a getter
; answered in the same start. Lab check on unit A (b21, 2026-10-07): 4 undervolt steps took 1206 mV to 1175-1181 mV
; under a steady load, and the cancel brought 1206-1212 mV back, with no WHEA event. 0 makes the surface read-only:
; no thread, no message.
HKR, Parameters, CpuTune,           0x00010003, 1
; The DirectFlip handshake, kernel half (wddm.c, docs/design/direct-flip-handshake.md, M15.14). 1 lets this start
; tell the compositor's user-mode driver, in the scan-out caps trailer, that it will admit a client scan-out flip
; and at what geometry. The driver ANDs it with every start-latched fact the flip path needs, so an open switch
; on a start that cannot flip still publishes nothing. 0 makes the trailer absent, which is 0.7.208.1 byte for
; byte at every buffer size.
HKR, Parameters, EnableDirectFlipHandshake, 0x00010003, 1
; The completion report pairs its own DPC-level notification (wddm.c, driver/kmd/notify_pairing.h, C50). 1 calls
; DxgkCbNotifyDpc at the end of the report pass, which is what the DDI text asks for, and the otherwise empty
; dxgkrnl DPC is not asked for at all: one DPC per completion fewer, measured at 12 to 20 us each. 0 is
; 0.7.208.1 exactly, where the notification arrives with the next dxgkrnl DPC.
HKR, Parameters, NotifyDpcInReport,  0x00010003, 1
; The VMID pool (gfx.c, driver/kmd/vmid_pool.h, docs/design/gfx-submit-root-serialization.md). 1 gives each page-table
; root its own VMID from a pool of up to 14, so a job of another process does not wait for the ring to drain. The
; driver never changes the root of a VMID whose last job has not retired. 0 is 0.7.213.1 exactly: every job at VMID 1.
HKR, Parameters, EnableVmidPool,     0x00010003, 1
; DisplayPort audio, steps 0 to 2 (dpaudio.c, docs/design/dp-audio.md, M819, M820). At every start and resume the
; driver checks the codec ID, the audio strap, the one DP stream the firmware left running, its DP SST back end, the
; endpoint's pin configuration and the DP reference clock. It writes nothing unless all of them hold. It needs BAR5
; (EnableMmio). Then it configures the Azalia endpoint (step 4: the LPCM descriptor, speakers, name and IDs of the
; monitor's EDID when display modes read one, else one LPCM descriptor of 2 channels at 32/44.1/48 kHz and 16 bit), starts the audio stream of that DP encoder (audio DTO1, AFMT clock, source, channels, AUD_N, timestamp,
; DP_SEC ASP, ATP, AIP and STREAM_ENABLE, then SAMPLE_SEND) and sets AUDIO_ENABLED last. The inbox HD Audio driver
; sees the endpoint only while the stream runs. EnableDpAudio 0 means no audio register is read or written at all,
; the behaviour before this feature. EnableDpAudioEndpoint 0 and EnableDpAudioStream 0 each refuse the whole start,
; so the endpoint stays hidden. The interrupt the inbox driver uses for that endpoint is the HD Audio function's own
; (PCI\VEN_1002&DEV_13FF), not this device's: the installer sets MSISupported there, because on a line interrupt the
; stream interrupts never arrive and the audio plays at 0.33x (BD-092).
HKR, Parameters, EnableDpAudio,      0x00010003, 1
HKR, Parameters, EnableDpAudioEndpoint, 0x00010003, 1
HKR, Parameters, EnableDpAudioStream, 0x00010003, 1
; Display modes, stage A (modeset.c, docs/design/display-modes.md). At start the driver reads the monitor's EDID over
; DP AUX, gives it to Windows as the monitor descriptor (the real monitor name), and offers the native mode and the
; smaller sizes of the EDID and of a list of common desktop sizes. The timing on the cable never changes: a smaller
; mode is scaled to the native timing by the display scaler. 2 = scaled, as the VidPN path asks (aspect ratio kept by
; default, stretched or centered). 1 = the EDID and the descriptor, smaller modes centered 1:1 without scaling. 0 means
; no AUX access, no descriptor and the one inherited mode, the behaviour before this feature. Needs EnableMmio and
; EnableDcnWrite; read once per start.
HKR, Parameters, EnableDisplayModes, 0x00010003, 2
; The SMU metrics table (smu_metrics.c, docs/design/dpm.md "Power reading"). 1 lets the DPM governor thread ask the
; SMU for its metrics table once a second, through the one SMU owner, into one driver page at the top of VRAM: the
; package power, the two rail voltages and the table's own clock and temperatures, for RUN_DPM ABI 3 and the control
; application's Power row. These are the three messages amdgpu sends on unit A (SetDriverTableDramAddrHigh and Low
; once per start, TransferTableSmu2Dram with table 6). A refusal or a timeout stops the reads until the next boot,
; and the governor runs on. 0 means no metrics message is sent and no page is mapped, the behaviour before this feature.
HKR, Parameters, EnableSmuMetrics,   0x00010003, 1
; M15.12 stage-1 hang recovery (wddm.c ResetEngine, docs/design/hang-recovery.md). 1 lets a node-0 engine reset
; kill the hung job's VMID waves (an SQ_CMD write) and, when the ring drains, report the reset as done, so only the
; process of the hung job loses its device and the desktop stays. Lab trial D1 of 0.7.216.17 (2026-10-07): one
; kill drained the ring, the client got DXGI_ERROR_DEVICE_HUNG, no bugcheck, the desktop visible 5.3 s later.
; Read once per device start; absent = 1. 0 is the 0.7.216.14 driver: ResetEngine refuses, and Windows resets the
; adapter, which this GPU cannot do (0x116). The verdicts go to the Parameters\HangRecovery subkey, which no
; install touches.
HKR, Parameters, HangRecoveryMode,  0x00010003, 1
; ---- memory manager stage 1 (wddm.c, 0.7.216.8): on when absent, so the INF writes no value ----------------------
; These switches are read once per device start and default to the feature on when the value is absent. The INF
; names none of them on purpose: a value the INF does not write is one a driver update can never reset, so an
; operator's bisect 0 survives every reinstall, and an install that never set one gets the driver's own default.
; Write the REG_DWORD under Parameters to change it; the start log names the configuration that ran.
;   ApertureSegmentMegabytes   the OS aperture (segment 2) size in MiB, absent = 384. 256 gives the aperture of every
;                              driver before 0.7.216.8 byte for byte; other values are clamped to 256..447, the
;                              largest whole MiB the 512 MiB GART holds after the private GTT and the paging window.
;                              If the GART refuses the size, the start falls back to 256 once instead of failing.
;                              Only MAP_APERTURE_SEGMENT operations use this range.
;   EnableSharedResidency      absent = 1. A VRAM allocation of the user-mode driver that is not a scan-out surface
;                              and not DISCARDABLE may also be resident in the aperture segment, second in order, so
;                              Windows can move it to system memory under pressure instead of evicting it, as amdgpu
;                              lets a VRAM buffer fall back to GTT. 0 gives the one local segment of 0.7.216.1.

[Strings]
Provider    = "amdgpu-wddm"
DiskName    = "bc250kmd installation media"
DeviceName  = "BC-250 GPU (amdgpu-wddm)"
ServiceName = "amdgpu-wddm kernel-mode driver"
